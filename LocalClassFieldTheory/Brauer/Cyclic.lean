import LocalClassFieldTheory.Brauer.ContH2

/-!
# Periodicity: `H²` of a finite cyclic group

Let `G` be a finite cyclic group (with the discrete topology) generated by `σ`, of order `n`, acting
on a commutative group `M`. We write `Ĥ⁰(G, M) = M^G / N_G(M)` (`ContH2.Hhat0 G M`) and prove the
classical periodicity isomorphism

`H²(G, M) ≃ Ĥ⁰(G, M)`, `[f] ↦ ∏_{i < n} f(σ^i, σ)`

(`ContH2.cyclicEquiv`). Its inverse sends `a ∈ M^G` to the class of the "carry" cocycle
`(σ^i, σ^j) ↦ a^{⌊(i + j)/n⌋}` (`0 ≤ i, j < n`), i.e. the cup product of `a` with the
fundamental class of `ℤ`.

## Main definitions

* `ContH2.fixedSubgroup G M`, `ContH2.normHom G M`, `ContH2.Hhat0 G M`.
* `ContH2.phiFun σ f = ∏_{i < n} f(σ^i, σ)`.
* `ContH2.cyclicHom σ hσ : ContH2 G M →* Hhat0 G M`, `ContH2.cyclicEquiv σ hσ`.

## Main results

* `ContH2.cyclicHom_injective`, `ContH2.cyclicHom_surjective`.
* `ContH2.phiFun_mapFun` : compatibility with inflation along `π : G' →* G`, `π σ' = σ`: the
  invariant is raised to the power `orderOf σ' / orderOf σ`.
-/

open groupCohomology Finset

namespace ContH2

section Generic

variable (G M : Type*) [Group G] [CommGroup M] [MulDistribMulAction G M]

/-- The invariants `M^G`. -/
def fixedSubgroup : Subgroup M where
  carrier := {m | ∀ g : G, g • m = m}
  mul_mem' {a b} ha hb g := by rw [smul_mul', ha g, hb g]
  one_mem' g := smul_one g
  inv_mem' {a} ha g := by rw [smul_inv', ha g]

variable {G M} in
theorem mem_fixedSubgroup {m : M} : m ∈ fixedSubgroup G M ↔ ∀ g : G, g • m = m := Iff.rfl

variable [Fintype G]

/-- The norm `m ↦ ∏_g g • m`. -/
def normHom : M →* M where
  toFun m := ∏ g : G, g • m
  map_one' := by simp
  map_mul' a b := by simp [smul_mul', prod_mul_distrib]

variable {G M} in
theorem normHom_apply (m : M) : normHom G M m = ∏ g : G, g • m := rfl

variable {G M} in
theorem normHom_mem_fixedSubgroup (m : M) : normHom G M m ∈ fixedSubgroup G M := by
  intro g
  rw [normHom_apply, smul_prod']
  simp_rw [smul_smul]
  exact Fintype.prod_equiv (Equiv.mulLeft g) _ _ (fun _ => rfl)

/-- The Tate group `Ĥ⁰(G, M) = M^G / N_G M`. -/
abbrev Hhat0 : Type _ := fixedSubgroup G M ⧸ (normHom G M).range.subgroupOf (fixedSubgroup G M)

variable {G M} in
theorem Hhat0.mk_eq_one_iff (a : fixedSubgroup G M) :
    (QuotientGroup.mk a : Hhat0 G M) = 1 ↔ ∃ m, normHom G M m = a := by
  rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf, MonoidHom.mem_range]

end Generic

section Index

variable {G : Type*} [Group G] [Finite G] (σ : G) (hσ : ∀ g, g ∈ Subgroup.zpowers σ)

include hσ in
theorem exists_pow_eq_lt (g : G) : ∃ k < orderOf σ, σ ^ k = g := by
  obtain ⟨k, hk⟩ := (isOfFinOrder_of_finite σ).mem_powers_iff_mem_zpowers.2 (hσ g)
  exact ⟨k % orderOf σ, Nat.mod_lt _ (orderOf_pos σ), by rw [pow_mod_orderOf]; exact hk⟩

/-- The exponent `0 ≤ k < n` with `σ ^ k = g`. -/
noncomputable def idx (g : G) : ℕ := Classical.choose (exists_pow_eq_lt σ hσ g)

theorem idx_lt (g : G) : idx σ hσ g < orderOf σ :=
  (Classical.choose_spec (exists_pow_eq_lt σ hσ g)).1

theorem pow_idx (g : G) : σ ^ idx σ hσ g = g :=
  (Classical.choose_spec (exists_pow_eq_lt σ hσ g)).2

theorem idx_pow {k : ℕ} (hk : k < orderOf σ) : idx σ hσ (σ ^ k) = k :=
  pow_injOn_Iio_orderOf (idx_lt σ hσ _) hk (pow_idx σ hσ _)

theorem idx_pow' (k : ℕ) : idx σ hσ (σ ^ k) = k % orderOf σ := by
  rw [← pow_mod_orderOf, idx_pow σ hσ (Nat.mod_lt _ (orderOf_pos σ))]

theorem idx_mul (g h : G) : idx σ hσ (g * h) = (idx σ hσ g + idx σ hσ h) % orderOf σ := by
  conv_lhs => rw [← pow_idx σ hσ g, ← pow_idx σ hσ h, ← pow_add]
  rw [idx_pow']

theorem idx_one : idx σ hσ 1 = 0 := by
  rw [← pow_zero σ, idx_pow σ hσ (orderOf_pos σ)]

include hσ in
/-- Products over `G` as products over the powers `σ ^ i`, `i < n`. -/
theorem prod_range_pow {M : Type*} [CommMonoid M] [Fintype G] (F : G → M) :
    ∏ i ∈ range (orderOf σ), F (σ ^ i) = ∏ g : G, F g := by
  refine prod_nbij (σ ^ ·) (fun _ _ => mem_univ _) ?_ ?_ (fun _ _ => rfl)
  · intro i hi j hj hij
    exact pow_injOn_Iio_orderOf (by simpa using hi) (by simpa using hj) hij
  · intro g _
    exact ⟨idx σ hσ g, by simpa using idx_lt σ hσ g, pow_idx σ hσ g⟩

include hσ in
theorem eq_one_of_orderOf_eq_one (hn : orderOf σ = 1) (g : G) : g = 1 := by
  obtain ⟨k, hk, rfl⟩ := exists_pow_eq_lt σ hσ g
  rw [hn, Nat.lt_one_iff] at hk
  rw [hk, pow_zero]

end Index

/-- Shifting the index of a product over `range n` of a function with `F n = F 0`. -/
theorem prod_range_shift {M : Type*} [CommGroup M] (F : ℕ → M) (n : ℕ) (h : F n = F 0) :
    ∏ i ∈ range n, F (i + 1) = ∏ i ∈ range n, F i := by
  have := (prod_range_succ' F n).symm.trans (prod_range_succ F n)
  rw [h] at this
  exact mul_right_cancel this

/-- A product over `range (m * n)` of an `n`-periodic function. -/
theorem prod_range_mul_of_periodic {M : Type*} [CommMonoid M] (F : ℕ → M) (n m : ℕ)
    (hF : ∀ i, F (i + n) = F i) : ∏ i ∈ range (m * n), F i = (∏ i ∈ range n, F i) ^ m := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [add_mul, one_mul, prod_range_add, ih, pow_succ]
    congr 1
    refine prod_congr rfl fun i _ => ?_
    have : ∀ k, F (k * n + i) = F i := by
      intro k
      induction k with
      | zero => simp
      | succ k ihk => rw [add_mul, one_mul, add_right_comm, hF, ihk]
    exact this m

noncomputable section Cyclic

variable {G M : Type*} [Group G] [Fintype G] [TopologicalSpace G]
  [CommGroup M] [MulDistribMulAction G M] (σ : G) (hσ : ∀ g, g ∈ Subgroup.zpowers σ)

/-- The periodicity map on cochains: `f ↦ ∏_{i < n} f(σ^i, σ)`. -/
def phiFun (f : G × G → M) : M := ∏ i ∈ range (orderOf σ), f (σ ^ i, σ)

omit [Fintype G] [TopologicalSpace G] [MulDistribMulAction G M] in
theorem phiFun_mul (f f' : G × G → M) : phiFun σ (f * f') = phiFun σ f * phiFun σ f' := by
  simp [phiFun, prod_mul_distrib]

omit [TopologicalSpace G] in
include hσ in
theorem phiFun_dx (x : G → M) : phiFun σ (dx G M x) = normHom G M (x σ) := by
  simp only [phiFun, dx_apply]
  rw [prod_mul_distrib, prod_div_distrib, normHom_apply,
    prod_range_pow σ hσ (fun g => g • x σ)]
  have h1 : ∏ i ∈ range (orderOf σ), x (σ ^ i * σ) = ∏ i ∈ range (orderOf σ), x (σ ^ i) := by
    simp_rw [← pow_succ]
    exact prod_range_shift (fun i => x (σ ^ i)) _ (by simp [pow_orderOf_eq_one])
  rw [h1, div_mul_cancel]

omit [TopologicalSpace G] in
include hσ in
theorem phiFun_mem_fixedSubgroup {f : G × G → M} (hf : IsMulCocycle₂ f) :
    phiFun σ f ∈ fixedSubgroup G M := by
  have hσfix : σ • phiFun σ f = phiFun σ f := by
    -- `σ • f(σ^i, σ) = f(σ^{i+1}, σ) * f(σ, σ^i) / f(σ, σ^{i+1})`
    have key : ∀ i : ℕ, σ • f (σ ^ i, σ) =
        f (σ ^ (i + 1), σ) * f (σ, σ ^ i) / f (σ, σ ^ (i + 1)) := by
      intro i
      have := hf σ (σ ^ i) σ
      rw [← pow_succ', ← pow_succ] at this
      rw [eq_div_iff_mul_eq', ← this]
    simp only [phiFun, smul_prod', key, prod_div_distrib, prod_mul_distrib]
    have h1 : ∏ i ∈ range (orderOf σ), f (σ ^ (i + 1), σ) =
        ∏ i ∈ range (orderOf σ), f (σ ^ i, σ) := by
      exact prod_range_shift (fun i => f (σ ^ i, σ)) _ (by simp [pow_orderOf_eq_one])
    have h2 : ∏ i ∈ range (orderOf σ), f (σ, σ ^ (i + 1)) =
        ∏ i ∈ range (orderOf σ), f (σ, σ ^ i) := by
      exact prod_range_shift (fun i => f (σ, σ ^ i)) _ (by simp [pow_orderOf_eq_one])
    rw [h1, h2, mul_div_cancel_right]
  intro g
  obtain ⟨k, -, rfl⟩ := exists_pow_eq_lt σ hσ g
  induction k with
  | zero => rw [pow_zero, one_smul]
  | succ k ih => rw [pow_succ, mul_smul, hσfix, ih]

/-- The periodicity map on cocycles. -/
def cocyclesHhat0 : cocycles G M →* Hhat0 G M where
  toFun f := QuotientGroup.mk ⟨phiFun σ f, phiFun_mem_fixedSubgroup σ hσ (isMulCocycle₂ f)⟩
  map_one' := by
    rw [← QuotientGroup.mk_one]
    congr 1
    ext
    simp [phiFun]
  map_mul' f f' := by
    rw [← QuotientGroup.mk_mul]
    congr 1
    ext
    exact phiFun_mul σ f f'

/-- The periodicity map `H²(G, M) → Ĥ⁰(G, M)` for a cyclic group with generator `σ`. -/
def cyclicHom : ContH2 G M →* Hhat0 G M :=
  QuotientGroup.lift _ (cocyclesHhat0 σ hσ) (by
    rintro f ⟨x, -, hxf⟩
    rw [MonoidHom.mem_ker, cocyclesHhat0, MonoidHom.coe_mk, OneHom.coe_mk, Hhat0.mk_eq_one_iff]
    refine ⟨x σ, ?_⟩
    rw [← phiFun_dx σ hσ, hxf])

theorem cyclicHom_mk (f : cocycles G M) :
    cyclicHom σ hσ (mk f) =
      QuotientGroup.mk ⟨phiFun σ f, phiFun_mem_fixedSubgroup σ hσ (isMulCocycle₂ f)⟩ := rfl

omit [TopologicalSpace G] in
include hσ in
/-- A 2-cocycle of a cyclic group is determined by `f (1, 1)` and the values `f (g, σ)`. -/
theorem eq_of_isMulCocycle₂ {f f' : G × G → M} (hf : IsMulCocycle₂ f) (hf' : IsMulCocycle₂ f')
    (h1 : f (1, 1) = f' (1, 1)) (hs : ∀ g, f (g, σ) = f' (g, σ)) : f = f' := by
  have hk : ∀ k : ℕ, ∀ g, f (g, σ ^ k) = f' (g, σ ^ k) := by
    intro k
    induction k with
    | zero =>
      intro g
      rw [pow_zero, map_one_snd_of_isMulCocycle₂ hf, map_one_snd_of_isMulCocycle₂ hf', h1]
    | succ k ih =>
      intro g
      have e := hf g (σ ^ k) σ
      have e' := hf' g (σ ^ k) σ
      rw [← pow_succ] at e e'
      rw [hs, ih g, hs (σ ^ k)] at e
      exact mul_left_cancel (e.symm.trans e')
  funext ⟨g, h⟩
  obtain ⟨k, -, rfl⟩ := exists_pow_eq_lt σ hσ h
  exact hk k g

theorem cyclicHom_injective [DiscreteTopology G] : Function.Injective (cyclicHom (M := M) σ hσ) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro α hα
  induction α using induction_on with | h f => ?_
  rw [MonoidHom.mem_ker, cyclicHom_mk, Hhat0.mk_eq_one_iff] at hα
  obtain ⟨m, hm⟩ := hα
  rw [Subgroup.mem_bot, mk_eq_one_iff]
  set c := f (1, 1) with hc
  let X : ℕ → M := fun k => c * ∏ i ∈ range k, (σ ^ i • m / f (σ ^ i, σ))
  refine ⟨fun g => X (idx σ hσ g), IsLocallyConstant.of_discrete _, ?_⟩
  have h11 : dx G M (fun g => X (idx σ hσ g)) (1, 1) = f (1, 1) := by
    simp [dx_apply, idx_one, X, hc]
  apply eq_of_isMulCocycle₂ σ hσ (isMulCocycle₂_dx _) (isMulCocycle₂ f) h11
  intro g
  obtain ⟨k, hk, rfl⟩ := exists_pow_eq_lt σ hσ g
  by_cases hn : orderOf σ = 1
  · have h1 := eq_one_of_orderOf_eq_one σ hσ hn
    have key : ∀ a b : G, a = 1 → b = 1 →
        dx G M (fun g => X (idx σ hσ g)) (a, b) = f (a, b) := by
      rintro a b rfl rfl
      exact h11
    exact key _ _ (h1 _) (h1 _)
  have hn2 : 1 < orderOf σ := by
    have := orderOf_pos σ
    omega
  have hxσ : X (idx σ hσ σ) = m := by
    have : idx σ hσ σ = 1 := by
      have := idx_pow σ hσ hn2
      rwa [pow_one] at this
    rw [this]
    simp only [X, range_one, prod_singleton, pow_zero, one_smul]
    rw [map_one_fst f, ← hc]
    mul_abel
  have hphi : phiFun σ (f : G × G → M) = normHom G M m := by
    rw [hm]
  rw [dx_apply, hxσ, ← pow_succ]
  rcases Nat.lt_or_ge (k + 1) (orderOf σ) with hk1 | hk1
  · rw [idx_pow σ hσ hk1, idx_pow σ hσ hk]
    simp only [X, prod_range_succ]
    mul_abel
  · have hk1 : k + 1 = orderOf σ := by omega
    rw [hk1, pow_orderOf_eq_one, idx_one, idx_pow σ hσ hk]
    rw [normHom_apply, ← prod_range_pow σ hσ (fun g => g • m), phiFun, ← hk1,
      prod_range_succ, prod_range_succ] at hphi
    simp only [X, range_zero, prod_empty, prod_div_distrib]
    have : f (σ ^ k, σ) = (∏ x ∈ range k, σ ^ x • m) * σ ^ k • m /
        ∏ x ∈ range k, f (σ ^ x, σ) := by
      rw [← hphi]
      mul_abel
    rw [this]
    mul_abel

/-- The "carry" cocycle `(σ^i, σ^j) ↦ a ^ ⌊(i + j) / n⌋`. -/
def cupFun (a : M) : G × G → M :=
  fun gh => a ^ ((idx σ hσ gh.1 + idx σ hσ gh.2) / orderOf σ)

theorem carry_add {n : ℕ} (hn : 0 < n) (a k : ℕ) : (a % n + k) / n + a / n = (a + k) / n := by
  conv_rhs => rw [← Nat.mod_add_div a n, add_right_comm, Nat.add_mul_div_left _ _ hn]

omit [TopologicalSpace G] in
theorem isMulCocycle₂_cupFun {a : M} (ha : a ∈ fixedSubgroup G M) :
    IsMulCocycle₂ (cupFun σ hσ a) := by
  intro g h j
  simp only [cupFun, smul_pow', ha g, ← pow_add, idx_mul]
  congr 1
  have hn := orderOf_pos σ
  rw [carry_add hn, add_assoc, Nat.add_comm (idx σ hσ g) (idx σ hσ h + idx σ hσ j),
    ← carry_add hn _ (idx σ hσ g), Nat.add_comm (_ % _) (idx σ hσ g), Nat.add_comm]

omit [TopologicalSpace G] in
theorem idx_self (hn2 : 1 < orderOf σ) : idx σ hσ σ = 1 := by
  have := idx_pow σ hσ hn2
  rwa [pow_one] at this

omit [TopologicalSpace G] [MulDistribMulAction G M] in
theorem phiFun_cupFun (hn2 : 1 < orderOf σ) (a : M) : phiFun σ (cupFun σ hσ a) = a := by
  have h : ∀ i ∈ range (orderOf σ), cupFun σ hσ a (σ ^ i, σ) = a ^ ((i + 1) / orderOf σ) := by
    intro i hi
    simp only [cupFun, idx_pow σ hσ (mem_range.1 hi), idx_self σ hσ hn2]
  rw [phiFun, prod_congr rfl h]
  generalize orderOf σ = n at hn2 ⊢
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [prod_range_succ, Nat.div_self (by omega), pow_one, prod_eq_one, one_mul]
  intro i hi
  rw [Nat.div_eq_of_lt (by simp at hi; omega), pow_zero]

theorem cyclicHom_surjective [DiscreteTopology G] :
    Function.Surjective (cyclicHom (M := M) σ hσ) := by
  intro q
  induction q using QuotientGroup.induction_on with | H a => ?_
  by_cases hn : orderOf σ = 1
  · refine ⟨1, ?_⟩
    rw [map_one, eq_comm, Hhat0.mk_eq_one_iff]
    refine ⟨a, ?_⟩
    rw [normHom_apply, ← prod_range_pow σ hσ (fun g => g • (a : M)), hn]
    simp
  · have hn2 : 1 < orderOf σ := by
      have := orderOf_pos σ
      omega
    refine ⟨mk (mkCocycle (cupFun σ hσ (a : M)) (.of_discrete _)
      (isMulCocycle₂_cupFun σ hσ a.2)), ?_⟩
    rw [cyclicHom_mk]
    congr 1
    ext
    exact phiFun_cupFun σ hσ hn2 _

/-- **Periodicity**: `H²(G, M) ≃ Ĥ⁰(G, M)` for a finite cyclic group `G` generated by `σ`. -/
def cyclicEquiv [DiscreteTopology G] : ContH2 G M ≃* Hhat0 G M :=
  MulEquiv.ofBijective (cyclicHom σ hσ) ⟨cyclicHom_injective σ hσ, cyclicHom_surjective σ hσ⟩

theorem cyclicEquiv_mk [DiscreteTopology G] (f : cocycles G M) :
    cyclicEquiv σ hσ (mk f) =
      QuotientGroup.mk ⟨phiFun σ f, phiFun_mem_fixedSubgroup σ hσ (isMulCocycle₂ f)⟩ := rfl

omit [Fintype G] [TopologicalSpace G] [MulDistribMulAction G M] in
/-- Compatibility of `phiFun` with inflation along `π : G' →* G` with `π σ' = σ`. -/
theorem phiFun_mapFun {G' M' : Type*} [Group G'] [CommGroup M'] (π : G' →* G) (ψ : M →* M')
    (σ' : G') (hπ : π σ' = σ) (f : G × G → M) :
    phiFun σ' (mapFun π ψ f) = ψ (phiFun σ f) ^ (orderOf σ' / orderOf σ) := by
  have hdvd : orderOf σ ∣ orderOf σ' := hπ ▸ orderOf_map_dvd π σ'
  simp only [phiFun, mapFun, map_pow, hπ, map_prod]
  conv_lhs => rw [← Nat.div_mul_cancel hdvd]
  refine prod_range_mul_of_periodic (fun i => ψ (f (σ ^ i, σ))) _ _ fun i => ?_
  simp only [pow_add, pow_orderOf_eq_one, mul_one]

end Cyclic

end ContH2

