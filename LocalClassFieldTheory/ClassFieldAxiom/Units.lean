import LocalClassFieldTheory.ClassFieldAxiom.Lattice

/-!
# An open subgroup of the units with trivial Tate cohomology

Let `L/K` be a finite cyclic extension of fields finite over `ℚ_[p]`, with `Gal(L/K)` generated by
`σ`. Using an integral normal basis `b` and the lattices `𝔅 k = lat p b k`, we define the
filtration `V k = 1 + 𝔅 (k + c)` of `Lˣ` by `Gal(L/K)`-stable subgroups and show, by successive
approximation, that on `V 0`

* every `σ`-invariant element is a norm `∏_g g y` of some `y ∈ V 0`;
* every element of norm one is of the form `σ y / y` with `y ∈ V 0`.

(Serre, *Local Fields*, V §2, and the corresponding lemma in XII §3.) Moreover `V 0` contains a
ball around `1` and consists of units of absolute value one.
-/

open Polynomial

set_option linter.unusedSectionVars false

namespace PadicField

variable {p : ℕ} [hp : Fact p.Prime]
variable {K L : Type*} [Field K] [Field L] [Algebra ℚ_[p] K] [Algebra ℚ_[p] L]
  [Algebra K L] [IsScalarTower ℚ_[p] K L] [FiniteDimensional ℚ_[p] K]
  [FiniteDimensional ℚ_[p] L] [FiniteDimensional K L] [IsGalois K L]

/-- The Galois action on units, as a monoid homomorphism. -/
abbrev galUnits (g : L ≃ₐ[K] L) : Lˣ →* Lˣ := Units.map (g : L →* L)

@[simp]
theorem coe_galUnits (g : L ≃ₐ[K] L) (x : Lˣ) : (galUnits g x : L) = g x := rfl

/-- The norm `∏_g g x` on units. -/
noncomputable def normUnits : Lˣ →* Lˣ := ∏ g : L ≃ₐ[K] L, galUnits g

theorem coe_normUnits (x : Lˣ) : (normUnits (K := K) x : L) = ∏ g : L ≃ₐ[K] L, g x := by
  simp [normUnits, Units.coe_prod]

theorem coe_normUnits_eq_norm (x : Lˣ) :
    (normUnits (K := K) x : L) = algebraMap K L (Algebra.norm K (x : L)) := by
  rw [coe_normUnits, Algebra.norm_eq_prod_automorphisms]

section Filtration

variable (b : Module.Basis (L ≃ₐ[K] L) K L) (hb : ∀ g, b g = g (b 1))
  (hb1 : nrm p L (b 1) ≤ 1) (N : ℕ)
  (hN : ∀ k : ℕ, ∀ x : L, nrm p L x ≤ ρ p K ^ (k + N) → x ∈ lat p b k)

include hb hb1 hN

theorem nrm_le_ρ_pow_of_mem {k : ℕ} {x : L} (hx : x ∈ lat p b k) : nrm p L x ≤ ρ p K ^ k :=
  nrm_le_of_mem_lat b hb hb1 hx

omit hb hb1 hN in
theorem ρ_pow_le {i j : ℕ} (h : i ≤ j) : ρ p K ^ j ≤ ρ p K ^ i :=
  pow_le_pow_of_le_one ρ_nonneg ρ_lt_one.le h

/-- A product of two elements of `𝔅 j` (with `j ≥ N`) is again in `𝔅 j`, and better. -/
theorem mul_mem_lat {j : ℕ} (hj : N ≤ j) {x y : L} (hx : x ∈ lat p b j) (hy : y ∈ lat p b j) :
    x * y ∈ lat p b j := by
  refine hN j _ ?_
  rw [nrm_mul]
  calc nrm p L x * nrm p L y ≤ ρ p K ^ j * ρ p K ^ j :=
        mul_le_mul (nrm_le_ρ_pow_of_mem b hb hb1 N hN hx) (nrm_le_ρ_pow_of_mem b hb hb1 N hN hy)
          (nrm_nonneg _) (pow_nonneg ρ_nonneg _)
    _ = ρ p K ^ (j + j) := (pow_add _ _ _).symm
    _ ≤ ρ p K ^ (j + N) := ρ_pow_le (by omega)

theorem nrm_eq_one_of_sub_one_mem {j : ℕ} {u : L} (hu : u - 1 ∈ lat p b (j + 1)) :
    nrm p L u = 1 := by
  have h := nrm_le_ρ_pow_of_mem b hb hb1 N hN hu
  have h1 : nrm p L (u - 1) < 1 := h.trans_lt (pow_lt_one₀ ρ_nonneg ρ_lt_one (by omega))
  have : u = 1 + (u - 1) := by ring
  rw [this, nrm_add_eq_left (by simpa using h1), nrm_one]

/-- The filtration `V k = 1 + 𝔅 (k + 2 N + 1)` of `Lˣ`. -/
noncomputable def filt (k : ℕ) : Subgroup Lˣ where
  carrier := {u | (u : L) - 1 ∈ lat p b (k + (2 * N + 1))}
  one_mem' := by simp [(lat p b _).zero_mem]
  mul_mem' {u v} hu hv := by
    simp only [Set.mem_setOf_eq, Units.val_mul] at *
    have : (u : L) * v - 1 = ((u : L) - 1) + ((v : L) - 1) + ((u : L) - 1) * ((v : L) - 1) := by
      ring
    rw [this]
    exact add_mem (add_mem hu hv) (mul_mem_lat b hb hb1 N hN (by omega) hu hv)
  inv_mem' {u} hu := by
    simp only [Set.mem_setOf_eq] at *
    have hu1 : nrm p L (u : L) = 1 := nrm_eq_one_of_sub_one_mem b hb hb1 N hN
      (j := k + 2 * N) (by simpa [add_assoc] using hu)
    have : ((u⁻¹ : Lˣ) : L) - 1 = -((u : L) - 1) + ((u : L) - 1) * ((u : L) - 1) * (u⁻¹ : Lˣ) := by
      have hu0 : (u : L) ≠ 0 := u.ne_zero
      simp only [Units.val_inv_eq_inv_val]
      field_simp
      ring
    rw [this]
    refine add_mem (neg_mem hu) (hN _ _ ?_)
    rw [nrm_mul, nrm_mul, Units.val_inv_eq_inv_val, nrm_inv, hu1, inv_one, mul_one]
    have h := nrm_le_ρ_pow_of_mem b hb hb1 N hN hu
    calc nrm p L ((u : L) - 1) * nrm p L ((u : L) - 1)
        ≤ ρ p K ^ (k + (2 * N + 1)) * ρ p K ^ (k + (2 * N + 1)) :=
          mul_le_mul h h (nrm_nonneg _) (pow_nonneg ρ_nonneg _)
      _ = ρ p K ^ (k + (2 * N + 1) + (k + (2 * N + 1))) := (pow_add _ _ _).symm
      _ ≤ _ := ρ_pow_le (by omega)

theorem mem_filt {k : ℕ} {u : Lˣ} :
    u ∈ filt b hb hb1 N hN k ↔ (u : L) - 1 ∈ lat p b (k + (2 * N + 1)) := Iff.rfl

theorem filt_succ_le (k : ℕ) : filt b hb hb1 N hN (k + 1) ≤ filt b hb hb1 N hN k :=
  fun _ hu ↦ lat_antitone b (by omega) hu

theorem nrm_sub_one_le_of_mem_filt {k : ℕ} {u : Lˣ} (hu : u ∈ filt b hb hb1 N hN k) :
    nrm p L ((u : L) - 1) ≤ ρ p K ^ (k + 1) :=
  (nrm_le_ρ_pow_of_mem b hb hb1 N hN hu).trans (ρ_pow_le (by omega))

theorem nrm_eq_one_of_mem_filt {k : ℕ} {u : Lˣ} (hu : u ∈ filt b hb hb1 N hN k) :
    nrm p L (u : L) = 1 :=
  nrm_eq_one_of_sub_one_mem b hb hb1 N hN (j := k + 2 * N) (by
    rw [mem_filt] at hu; simpa [add_assoc] using hu)

theorem mem_filt_of_nrm_le (k : ℕ) (u : Lˣ)
    (hu : nrm p L ((u : L) - 1) ≤ ρ p K ^ (k + (2 * N + 1) + N)) : u ∈ filt b hb hb1 N hN k :=
  hN _ _ hu

theorem galUnits_mem_filt {k : ℕ} {u : Lˣ} (hu : u ∈ filt b hb hb1 N hN k)
    (g : L ≃ₐ[K] L) : galUnits g u ∈ filt b hb hb1 N hN k := by
  rw [mem_filt, coe_galUnits, show g (u : L) - 1 = g ((u : L) - 1) by simp]
  exact galois_mem_lat b hb hu g

theorem normUnits_mem_filt {k : ℕ} {u : Lˣ} (hu : u ∈ filt b hb hb1 N hN k) :
    normUnits (K := K) u ∈ filt b hb hb1 N hN k := by
  rw [normUnits, MonoidHom.finsetProd_apply]
  exact Subgroup.prod_mem _ fun g _ ↦ galUnits_mem_filt b hb hb1 N hN hu g

end Filtration

end PadicField
