import LocalClassFieldTheory.Duality.H3Vanishing
import LocalClassFieldTheory.Duality.ZModPrime

/-!
# The Euler characteristic formula for all finite modules with trivial action

The dévissage `PadicField.eulerCharacteristicFor_of_shortExact` needs the surjectivity of
`H²(K, B) → H²(K, C)`. For the extensions `0 → ℤ/ℓ^e → ℤ/ℓ^{e+1} → ℤ/ℓ → 0` (trivial action)
we prove it **without `H³`**, by a Bockstein argument:

* naturality of the connecting map `δ¹` (`Brauer.GShortExact.delta1_natural`);
* the extensions `0 → ℤ/a → ℤ/ab → ℤ/b → 0` (`Brauer.trivZModSES a b`, `k ↦ b k`, reduction);
* if `μ_ℓ ⊆ K` and `f ≥ 1` is maximal with `μ_{ℓ^f} ⊆ K`, the reduction
  `H¹(K, ℤ/ℓ^{f+1}) → H¹(K, ℤ/ℓ^f)` is **not** surjective: by `PadicField.card_h1_trivZMod`
  (`#H¹(K, ℤ/n) = n · #μ_n(K) · p^{v_p(n)[K : ℚ_p]}`, from Kummer theory and the index formula
  for `(Kˣ)ⁿ`) the orders do not match (`PadicField.exists_delta1_ne_one`). Hence the connecting
  map of `0 → ℤ/ℓ → ℤ/ℓ^{f+1} → ℤ/ℓ^f → 0` hits a nonzero class `δ(χ)` of `H²(K, ℤ/ℓ)`, which
  has prime order `ℓ = #μ_ℓ(K)` and is therefore generated by it;
* by naturality along `(0 → ℤ/N → ℤ/Nℓ^f → ℤ/ℓ^f → 0) ⟶ (0 → ℤ/ℓ → ℤ/ℓ^{f+1} → ℤ/ℓ^f → 0)`,
  `δ(χ)` lies in the image of the reduction `H²(K, ℤ/N) → H²(K, ℤ/ℓ)` for every `ℓ ∣ N`:
  **`PadicField.h2_castMulHom_surjective`** (if `μ_ℓ ⊄ K` then `H²(K, ℤ/ℓ) = 0`).

The only assumption is that `μ_{ℓ^∞} ⊄ K` in the weak form `∃ k, μ_{ℓ^k} ⊄ K`; when it fails for
the exponent at hand, `μ_{ℓ^e} ⊆ K` and the formula is already known
(`PadicField.eulerCharacteristicFor_trivZMod`). Consequences, **without any assumption on `K`**:

* **`PadicField.eulerCharacteristicFor_trivZMod_primePow`**: the formula for `ℤ/ℓ^e`;
* **`PadicField.eulerCharacteristicFor_trivZMod_all`**: the formula for `ℤ/n`, every `n ≥ 1`;
* **`PadicField.card_h2_trivZMod`**: `#H²(K, ℤ/n) = #μ_n(K) = #H⁰(K, Hom(ℤ/n, μ_n))`;
* **`PadicField.eulerCharacteristicFor_of_trivial_all`**: the local Euler characteristic formula
  for **every finite module with trivial Galois action**.
-/

open ContH2 groupCohomology KummerTheory

set_option linter.unusedSectionVars false

namespace Brauer

/-! ### Naturality of `δ¹` -/

namespace GShortExact

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {A B C A' B' : Type*} [CommGroup A] [CommGroup B] [CommGroup C] [CommGroup A'] [CommGroup B']
  [MulDistribMulAction G A] [MulDistribMulAction G B] [MulDistribMulAction G C]
  [MulDistribMulAction G A'] [MulDistribMulAction G B']
  [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalGroup A]
  [TopologicalSpace B] [DiscreteTopology B] [IsTopologicalGroup B] [SmoothAction G B]
  [TopologicalSpace C] [DiscreteTopology C] [IsTopologicalGroup C]
  [TopologicalSpace A'] [DiscreteTopology A'] [IsTopologicalGroup A']
  [TopologicalSpace B'] [DiscreteTopology B'] [IsTopologicalGroup B'] [SmoothAction G B']

/-- **Naturality of the connecting map** for a morphism of short exact sequences
`(0 → A → B → C → 0) ⟶ (0 → A' → B' → C → 0)` which is the identity on `C`. -/
theorem delta1_natural (S : GShortExact G A B C) (S' : GShortExact G A' B' C) (α : A →* A')
    (hα : ∀ (g : G) (a : A), α (g • a) = g • α a) (β : B →* B')
    (hβ : ∀ (g : G) (b : B), β (g • b) = g • β b) (hiα : ∀ a, S'.i (α a) = β (S.i a))
    (hπβ : ∀ b, S'.π (β b) = S.π b) (x : ContH1 G C) :
    S'.delta1 x = h2Hom α hα (S.delta1 x) := by
  induction x using ContH1.induction_on with | h x => ?_
  rw [S'.delta1_mk x (y := fun g => β (S.sec (x g))) ((S.isLocallyConstant_sec_comp x).comp β)
    (fun g => by rw [hπβ, S.π_sec]),
    S.delta1_mk x (S.isLocallyConstant_sec_comp x) (fun g => S.π_sec _), h2Hom_mk]
  congr 1
  refine cocycles_ext fun g h => S'.injective ?_
  rw [S'.i_delta1Cocycle]
  change _ = S'.i (α (S.delta1Cocycle _ _ _ (g, h)))
  rw [hiα, S.i_delta1Cocycle]
  simp only [dx_apply, map_mul, map_div, hβ]

end GShortExact

/-! ### The extensions `0 → ℤ/a → ℤ/ab → ℤ/b → 0` -/

section TrivSES

/-- Reduction `ℤ/n → ℤ/m` for `m ∣ n`. -/
def castMulHom {m n : ℕ} (h : m ∣ n) : TrivZMod n →* TrivZMod m :=
  AddMonoidHom.toMultiplicative (ZMod.castHom h (ZMod m)).toAddMonoidHom

theorem castMulHom_apply {m n : ℕ} (h : m ∣ n) (k : TrivZMod n) :
    Multiplicative.toAdd (castMulHom h k) = ZMod.cast (Multiplicative.toAdd k) := rfl

/-- Multiplication by `b`, `ℤ/a → ℤ/ab`. -/
def mulRightZMod (a b : ℕ) : ZMod a →+ ZMod (a * b) :=
  ZMod.lift a ⟨(AddMonoidHom.mulRight (b : ZMod (a * b))).comp (Int.castAddHom _), by
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, Int.coe_castAddHom, Int.cast_natCast,
      AddMonoidHom.coe_mulRight, ← Nat.cast_mul, ZMod.natCast_self]⟩

theorem mulRightZMod_apply (a b : ℕ) [NeZero a] (k : ZMod a) :
    mulRightZMod a b k = (k.val : ZMod (a * b)) * b := by
  conv_lhs => rw [← ZMod.natCast_zmod_val k, ← Int.cast_natCast]
  rw [mulRightZMod, ZMod.lift_coe]
  simp

/-- `0 → ℤ/a → ℤ/ab → ℤ/b → 0`, `k ↦ b k`, with trivial actions. -/
noncomputable def trivZModSES (G : Type*) [Monoid G] (a b : ℕ) [NeZero a] [NeZero b] :
    GShortExact G (TrivZMod a) (TrivZMod (a * b)) (TrivZMod b) where
  i := AddMonoidHom.toMultiplicative (mulRightZMod a b)
  π := castMulHom (dvd_mul_left b a)
  map_smul_i _ _ := rfl
  map_smul_π _ _ := rfl
  injective := by
    intro k k' h
    have h' : mulRightZMod a b (Multiplicative.toAdd k) =
        mulRightZMod a b (Multiplicative.toAdd k') := h
    rw [← sub_eq_zero, ← map_sub, mulRightZMod_apply, ← Nat.cast_mul,
      ZMod.natCast_eq_zero_iff] at h'
    have hd : a ∣ (Multiplicative.toAdd k - Multiplicative.toAdd k').val :=
      Nat.dvd_of_mul_dvd_mul_right (Nat.pos_of_ne_zero (NeZero.ne b)) h'
    have h0 := Nat.eq_zero_of_dvd_of_lt hd (ZMod.val_lt _)
    rw [ZMod.val_eq_zero, sub_eq_zero] at h0
    exact h0
  surjective := by
    intro c
    refine ⟨Multiplicative.ofAdd ((Multiplicative.toAdd c).val : ZMod (a * b)), ?_⟩
    apply Multiplicative.toAdd.injective
    rw [castMulHom_apply, toAdd_ofAdd, ZMod.cast_natCast (dvd_mul_left b a),
      ZMod.natCast_zmod_val]
  exact y := by
    constructor
    · intro hy
      have hy' : (ZMod.cast (Multiplicative.toAdd y) : ZMod b) = 0 :=
        congrArg Multiplicative.toAdd hy
      rw [ZMod.cast_eq_val, ZMod.natCast_eq_zero_iff] at hy'
      obtain ⟨m, hm⟩ := hy'
      have hlt : m < a := by
        have := ZMod.val_lt (Multiplicative.toAdd y)
        rw [hm] at this
        exact Nat.lt_of_mul_lt_mul_left (by rwa [mul_comm a b] at this)
      refine ⟨Multiplicative.ofAdd (m : ZMod a), ?_⟩
      apply Multiplicative.toAdd.injective
      change mulRightZMod a b (m : ZMod a) = Multiplicative.toAdd y
      rw [mulRightZMod_apply, ZMod.val_cast_of_lt hlt, ← Nat.cast_mul, Nat.mul_comm m b, ← hm,
        ZMod.natCast_zmod_val]
    · rintro ⟨k, rfl⟩
      apply Multiplicative.toAdd.injective
      change (ZMod.cast (mulRightZMod a b (Multiplicative.toAdd k)) : ZMod b) = 0
      rw [mulRightZMod_apply, ← Nat.cast_mul, ZMod.cast_natCast (dvd_mul_left b a),
        Nat.cast_mul, ZMod.natCast_self, mul_zero]

theorem trivZModSES_i_apply (G : Type*) [Monoid G] (a b : ℕ) [NeZero a] [NeZero b]
    (k : TrivZMod a) : Multiplicative.toAdd ((trivZModSES G a b).i k) =
      ((Multiplicative.toAdd k).val : ZMod (a * b)) * b :=
  mulRightZMod_apply a b _

end TrivSES

end Brauer

namespace PadicField

open Brauer

variable {p : ℕ} [hp : Fact p.Prime]
variable {K : Type*} [Field K] [Algebra ℚ_[p] K] [FiniteDimensional ℚ_[p] K]
variable {Ω : Type*} [Field Ω] [Algebra K Ω] [Algebra ℚ_[p] Ω] [IsScalarTower ℚ_[p] K Ω]
  [IsAlgClosed Ω] [IsGalois K Ω]

local notation "G_K" => Ω ≃ₐ[K] Ω

/-! ### Roots of unity of prime power order -/

include hp Ω in
/-- `#μ_n(K) ∣ n`. -/
theorem card_rootsOfUnity_dvd (n : ℕ) [NeZero n] : Nat.card (rootsOfUnity n K) ∣ n := by
  have := Subgroup.card_subgroup_dvd_card (H0 (Ω ≃ₐ[K] Ω) (Mu n Ω))
  rwa [card_h0_mu, card_mu (p := p)] at this

include hp Ω in
/-- If `μ_{ℓ^f} ⊆ K` but `μ_{ℓ^{f+1}} ⊄ K` then `#μ_{ℓ^{f+1}}(K) = ℓ^f`. -/
theorem card_rootsOfUnity_succ {ℓ : ℕ} [hℓ : Fact ℓ.Prime] {f : ℕ}
    (hf : Nat.card (rootsOfUnity (ℓ ^ f) K) = ℓ ^ f)
    (hf1 : Nat.card (rootsOfUnity (ℓ ^ (f + 1)) K) ≠ ℓ ^ (f + 1)) :
    Nat.card (rootsOfUnity (ℓ ^ (f + 1)) K) = ℓ ^ f := by
  haveI : NeZero (ℓ ^ (f + 1)) := ⟨pow_ne_zero _ hℓ.out.ne_zero⟩
  obtain ⟨j, hj, hj'⟩ := (Nat.dvd_prime_pow hℓ.out).1
    (card_rootsOfUnity_dvd (p := p) (Ω := Ω) (K := K) (ℓ ^ (f + 1)))
  have hle : ℓ ^ f ∣ ℓ ^ j := by
    rw [← hf, ← hj']
    exact Subgroup.card_dvd_of_le (rootsOfUnity_le_of_dvd (pow_dvd_pow ℓ (Nat.le_succ f)))
  rw [Nat.pow_dvd_pow_iff_le_right hℓ.out.one_lt] at hle
  rcases (show j = f ∨ j = f + 1 by omega) with rfl | rfl
  · exact hj'
  · exact absurd hj' hf1

/-! ### A nonzero Bockstein class -/

include hp in
/-- If `μ_ℓ ⊆ K`, `μ_{ℓ^f} ⊆ K` and `μ_{ℓ^{f+1}} ⊄ K`, the connecting map of
`0 → ℤ/ℓ → ℤ/ℓ^{f+1} → ℤ/ℓ^f → 0` is nonzero on `H¹(K, ℤ/ℓ^f)`. -/
theorem exists_delta1_ne_one {ℓ : ℕ} [hℓ : Fact ℓ.Prime] {f : ℕ} [NeZero (ℓ ^ f)]
    (h1 : Nat.card (rootsOfUnity ℓ K) = ℓ) (hf : Nat.card (rootsOfUnity (ℓ ^ f) K) = ℓ ^ f)
    (hf1 : Nat.card (rootsOfUnity (ℓ ^ (f + 1)) K) ≠ ℓ ^ (f + 1)) :
    ∃ χ : ContH1 G_K (TrivZMod (ℓ ^ f)), (trivZModSES G_K ℓ (ℓ ^ f)).delta1 χ ≠ 1 := by
  haveI : NeZero ℓ := ⟨hℓ.out.ne_zero⟩
  set S := trivZModSES G_K ℓ (ℓ ^ f)
  by_contra hcon
  push Not at hcon
  -- `H¹(A) → H¹(B)` is injective since `H⁰(B) → H⁰(C)` is onto
  have hδ0 : S.delta0.range = ⊥ := by
    rw [eq_bot_iff]
    rintro _ ⟨c, rfl⟩
    have : c ∈ S.delta0.ker := by
      rw [S.exact_h0C]
      obtain ⟨b, hb⟩ := S.surjective (c : TrivZMod (ℓ ^ f))
      exact ⟨⟨b, fun _ => rfl⟩, Subtype.ext hb⟩
    exact this
  have hinj : (h1Hom (G := G_K) S.i S.map_smul_i).ker = ⊥ := by rw [S.exact_h1A, hδ0]
  have hsurj : (h1Hom (G := G_K) S.π S.map_smul_π).range = ⊤ := by
    rw [← S.exact_h1C, eq_top_iff]
    intro x _
    exact hcon x
  have hcard := card_eq_card_ker_mul_card_range (h1Hom (G := G_K) S.π S.map_smul_π)
  rw [S.exact_h1B, hsurj, Subgroup.card_top,
    ← Nat.card_congr (MonoidHom.ofInjective
      ((MonoidHom.ker_eq_bot_iff _).1 hinj)).toEquiv] at hcard
  have e := card_h1_trivZMod (p := p) (K := K) (Ω := Ω) (ℓ * ℓ ^ f)
  rw [hcard, card_h1_trivZMod (p := p), card_h1_trivZMod (p := p), h1, hf,
    ← pow_succ', card_rootsOfUnity_succ (p := p) (Ω := Ω) hf hf1, pow_succ',
    padicValNat.mul hℓ.out.ne_zero (pow_ne_zero _ hℓ.out.ne_zero), add_mul, pow_add] at e
  set X := p ^ (padicValNat p ℓ * Module.finrank ℚ_[p] K) *
    p ^ (padicValNat p (ℓ ^ f) * Module.finrank ℚ_[p] K) * (ℓ ^ f * ℓ ^ f)
  have hX : 0 < X := Nat.mul_pos (Nat.mul_pos (pow_pos hp.out.pos _) (pow_pos hp.out.pos _))
    (Nat.mul_pos (pow_pos hℓ.out.pos _) (pow_pos hℓ.out.pos _))
  have e' : ℓ * ℓ * X = ℓ * X := by
    calc ℓ * ℓ * X = _ := by simp only [X]; ring
      _ = _ := e
      _ = ℓ * X := by simp only [X]; ring
  have := Nat.eq_of_mul_eq_mul_right hX e'
  have h2 : ℓ * ℓ = ℓ * 1 := by rw [mul_one]; exact this
  exact hℓ.out.one_lt.ne' (Nat.eq_of_mul_eq_mul_left hℓ.out.pos h2)

/-! ### Surjectivity of `H²(K, ℤ/N) → H²(K, ℤ/ℓ)` -/

include hp in
/-- **`H²(K, ℤ/N) → H²(K, ℤ/ℓ)` is surjective** for every prime `ℓ ∣ N`, provided some
`μ_{ℓ^k} ⊄ K`. -/
theorem h2_castMulHom_surjective {ℓ : ℕ} [hℓ : Fact ℓ.Prime] (N : ℕ) [NeZero N] (hN : ℓ ∣ N)
    (hK : ∃ k, Nat.card (rootsOfUnity (ℓ ^ k) K) ≠ ℓ ^ k) :
    Function.Surjective (h2Hom (G := G_K) (castMulHom hN) (fun _ _ => rfl)) := by
  haveI : NeZero ℓ := ⟨hℓ.out.ne_zero⟩
  by_cases h1 : Nat.card (rootsOfUnity ℓ K) = ℓ
  swap
  · haveI := subsingleton_h2_trivZMod_prime (p := p) (Ω := Ω) h1
    exact fun γ => ⟨1, Subsingleton.elim _ _⟩
  have hK' : ∃ k, Nat.card (rootsOfUnity (ℓ ^ (k + 1)) K) ≠ ℓ ^ (k + 1) := by
    obtain ⟨k, hk⟩ := hK
    rcases k with _ | k
    · refine absurd ?_ hk
      rw [pow_zero, Nat.card_eq_one_iff_unique]
      exact ⟨inferInstance, inferInstance⟩
    · exact ⟨k, hk⟩
  classical
  set f := Nat.find hK' with hf_def
  have hf1 : Nat.card (rootsOfUnity (ℓ ^ (f + 1)) K) ≠ ℓ ^ (f + 1) := Nat.find_spec hK'
  have hfpos : f ≠ 0 := by
    intro h0
    rw [h0, zero_add, pow_one] at hf1
    exact hf1 h1
  have hf : Nat.card (rootsOfUnity (ℓ ^ f) K) = ℓ ^ f := by
    obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero hfpos
    have := Nat.find_min hK' (show j < f by omega)
    push Not at this
    rw [hj]
    exact this
  haveI : NeZero (ℓ ^ f) := ⟨pow_ne_zero _ hℓ.out.ne_zero⟩
  obtain ⟨χ, hχ⟩ := exists_delta1_ne_one (p := p) (K := K) (Ω := Ω) h1 hf hf1
  -- naturality along `(0 → ℤ/N → ℤ/Nℓ^f → ℤ/ℓ^f → 0) ⟶ (0 → ℤ/ℓ → ℤ/ℓ^{f+1} → ℤ/ℓ^f → 0)`
  have hnat := GShortExact.delta1_natural (trivZModSES G_K N (ℓ ^ f))
    (trivZModSES G_K ℓ (ℓ ^ f)) (castMulHom hN) (fun _ _ => rfl)
    (castMulHom (mul_dvd_mul_right hN (ℓ ^ f))) (fun _ _ => rfl) (fun k => by
      apply Multiplicative.toAdd.injective
      rw [trivZModSES_i_apply, castMulHom_apply, castMulHom_apply, trivZModSES_i_apply,
        ZMod.cast_eq_val, ZMod.val_natCast, ZMod.cast_mul (mul_dvd_mul_right hN (ℓ ^ f)),
        ZMod.cast_natCast (mul_dvd_mul_right hN (ℓ ^ f)),
        ZMod.cast_natCast (mul_dvd_mul_right hN (ℓ ^ f))]
      generalize (Multiplicative.toAdd k).val = v
      have h0 : ((ℓ * ℓ ^ f : ℕ) : ZMod (ℓ * ℓ ^ f)) = 0 := ZMod.natCast_self _
      conv_rhs => rw [← Nat.mod_add_div v ℓ]
      rw [Nat.cast_add, add_mul, Nat.cast_mul ℓ, mul_comm (ℓ : ZMod (ℓ * ℓ ^ f)), mul_assoc,
        ← Nat.cast_mul ℓ, h0, mul_zero, add_zero])
    (fun b => by
      apply Multiplicative.toAdd.injective
      change ZMod.cast (ZMod.cast (Multiplicative.toAdd b) : ZMod (ℓ * ℓ ^ f)) =
        (ZMod.cast (Multiplicative.toAdd b) : ZMod (ℓ ^ f))
      rw [← ZMod.castHom_apply (h := mul_dvd_mul_right hN (ℓ ^ f)),
        ← ZMod.castHom_apply (h := dvd_mul_left (ℓ ^ f) ℓ),
        ← ZMod.castHom_apply (h := dvd_mul_left (ℓ ^ f) N), ← RingHom.comp_apply,
        ZMod.castHom_comp]) χ
  -- `H²(K, ℤ/ℓ)` has prime order `ℓ`
  haveI : Fact (Nat.card (ContH2 G_K (TrivZMod ℓ))).Prime := by
    rw [card_h2_trivZMod_prime (p := p), h1]
    exact hℓ
  rcases (h2Hom (G := G_K) (castMulHom hN) (fun _ _ => rfl)).range.eq_bot_or_eq_top_of_prime_card
    with hbot | htop
  · refine absurd ?_ hχ
    rw [hnat]
    have : h2Hom (G := G_K) (castMulHom hN) (fun _ _ => rfl)
        ((trivZModSES G_K N (ℓ ^ f)).delta1 χ) ∈ (⊥ : Subgroup _) := by
      rw [← hbot]
      exact ⟨_, rfl⟩
    exact this
  · exact MonoidHom.range_eq_top.1 htop

/-! ### The Euler characteristic formula for `ℤ/n` and trivial modules -/

include hp in
/-- **The local Euler characteristic formula for `ℤ/ℓ^e`**, without any assumption on `K`. -/
theorem eulerCharacteristicFor_trivZMod_primePow (ℓ : ℕ) [hℓ : Fact ℓ.Prime] :
    ∀ e : ℕ, EulerCharacteristicFor p K Ω (TrivZMod (ℓ ^ e))
  | 0 => by
    rw [pow_zero]
    haveI : Subsingleton (TrivZMod 1) := inferInstanceAs (Subsingleton (Multiplicative (ZMod 1)))
    exact eulerCharacteristicFor_of_subsingleton
  | e + 1 => by
    haveI : NeZero ℓ := ⟨hℓ.out.ne_zero⟩
    haveI : NeZero (ℓ ^ e) := ⟨pow_ne_zero _ hℓ.out.ne_zero⟩
    haveI : NeZero (ℓ ^ (e + 1)) := ⟨pow_ne_zero _ hℓ.out.ne_zero⟩
    haveI : NeZero (ℓ ^ e * ℓ) := ⟨by rw [← pow_succ]; exact NeZero.ne _⟩
    by_cases h : Nat.card (rootsOfUnity (ℓ ^ (e + 1)) K) = ℓ ^ (e + 1)
    · exact eulerCharacteristicFor_trivZMod h
    · have hs := h2_castMulHom_surjective (p := p) (K := K) (Ω := Ω) (ℓ ^ e * ℓ)
        (dvd_mul_left ℓ _) ⟨e + 1, h⟩
      have := eulerCharacteristicFor_of_shortExact (trivZModSES G_K (ℓ ^ e) ℓ) hs
        (eulerCharacteristicFor_trivZMod_primePow ℓ e) (eulerCharacteristicFor_trivZMod_prime ℓ)
      rwa [← pow_succ] at this

include hp in
/-- **The local Euler characteristic formula for `ℤ/n`**, every `n ≥ 1`, without any assumption
on `K`. -/
theorem eulerCharacteristicFor_trivZMod_all (n : ℕ) [NeZero n] :
    EulerCharacteristicFor p K Ω (TrivZMod n) := by
  have key : ∀ m : ℕ, m ≠ 0 → EulerCharacteristicFor p K Ω (TrivZMod m) := by
    intro m
    induction m using Nat.recOnPosPrimePosCoprime with
    | prime_pow ℓ k hℓ _ =>
      intro _
      haveI : Fact ℓ.Prime := ⟨hℓ⟩
      exact eulerCharacteristicFor_trivZMod_primePow ℓ k
    | zero => exact fun h => absurd rfl h
    | one =>
      intro _
      haveI : Subsingleton (TrivZMod 1) :=
        inferInstanceAs (Subsingleton (Multiplicative (ZMod 1)))
      exact eulerCharacteristicFor_of_subsingleton
    | coprime a b ha hb hab iha ihb =>
      intro _
      haveI : NeZero a := ⟨by omega⟩
      haveI : NeZero b := ⟨by omega⟩
      exact eulerCharacteristicFor_trivZMod_mul hab (iha (by omega)) (ihb (by omega))
  exact key n (NeZero.ne n)

include hp in
/-- **`#H²(K, ℤ/n) = #μ_n(K)`** for every `n ≥ 1` (the cardinality part of local duality
`H²(K, ℤ/n) ≅ H⁰(K, μ_n)^∨`). -/
theorem card_h2_trivZMod (n : ℕ) [NeZero n] :
    Nat.card (ContH2 G_K (TrivZMod n)) = Nat.card (rootsOfUnity n K) := by
  obtain ⟨-, -, h⟩ := eulerCharacteristicFor_trivZMod_all (p := p) (K := K) (Ω := Ω) n
  rw [card_h1_trivZMod (p := p), TrivZMod.h0_eq_top, Subgroup.card_top, TrivZMod.card] at h
  have hn : 0 < n * p ^ (padicValNat p n * Module.finrank ℚ_[p] K) :=
    Nat.mul_pos (Nat.pos_of_ne_zero (NeZero.ne n)) (pow_pos hp.out.pos _)
  apply Nat.eq_of_mul_eq_mul_left hn
  calc _ = n * Nat.card (ContH2 G_K (TrivZMod n)) * p ^ (padicValNat p n *
        Module.finrank ℚ_[p] K) := by ring
    _ = _ := h.symm
    _ = _ := by ring

include hp in
/-- **The local Euler characteristic formula for every finite module with trivial Galois
action**, without any assumption on `K`. -/
theorem eulerCharacteristicFor_of_trivial_all (M : Type*) [CommGroup M] [Finite M]
    [TopologicalSpace M] [DiscreteTopology M] [IsTopologicalGroup M]
    [MulDistribMulAction G_K M] [SmoothAction G_K M]
    (htriv : ∀ (g : G_K) (m : M), g • m = m) : EulerCharacteristicFor p K Ω M :=
  eulerCharacteristicFor_of_trivial' M htriv fun n _ _ _ => eulerCharacteristicFor_trivZMod_all n

end PadicField
