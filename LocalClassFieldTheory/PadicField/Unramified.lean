import LocalClassFieldTheory.PadicField.Tower
import LocalClassFieldTheory.PadicField.Complete
import LocalClassFieldTheory.PadicField.Teichmuller

/-!
# Unramified extensions

An extension `L/K` of fields finite over `ℚ_[p]` is *unramified* if `e(L/K) = 1`.

## Main results

* `PadicField.adjoin_teichmuller_eq_top`: an unramified `L/K` is generated by the Teichmüller
  representatives of its residue field.
* `PadicField.isSplittingField_of_isUnramified`: an unramified `L/K` is the splitting field of
  `X ^ Q - X` (`Q = #𝓴 L`); in particular it is Galois (`PadicField.isGalois_of_isUnramified`).
-/

open Polynomial IsLocalRing

namespace PadicField

variable {p : ℕ} [hp : Fact p.Prime]

variable (p) in
/-- An extension is unramified if its ramification index is `1`. -/
def IsUnramified (K L : Type*) [Field K] [Field L] [Algebra ℚ_[p] K] [Algebra ℚ_[p] L]
    [Algebra K L] [IsScalarTower ℚ_[p] K L] [FiniteDimensional ℚ_[p] K]
    [FiniteDimensional ℚ_[p] L] : Prop :=
  e p K L = 1

variable {K L : Type*} [Field K] [Field L] [Algebra ℚ_[p] K] [Algebra ℚ_[p] L]
  [Algebra K L] [IsScalarTower ℚ_[p] K L] [FiniteDimensional ℚ_[p] K]
  [FiniteDimensional ℚ_[p] L]

theorem IsUnramified.f_eq (h : IsUnramified p K L) : f p K L = Module.finrank K L := by
  rw [← e_mul_f (p := p), h, one_mul]

theorem isUnramified_iff_f_eq : IsUnramified p K L ↔ f p K L = Module.finrank K L := by
  refine ⟨IsUnramified.f_eq, fun h ↦ ?_⟩
  have h1 := e_mul_f (p := p) (K := K) (L := L)
  rw [h] at h1
  have hpos : 0 < Module.finrank K L := h ▸ f_pos
  exact (Nat.mul_eq_right hpos.ne').1 h1

variable (p L) in
/-- The Teichmüller representatives of `𝓴 L`, as elements of `L`. -/
noncomputable def teichmullerSet : Set L :=
  Set.range fun a : 𝓴 p L ↦ ((Teichmuller.teichmuller (𝒪 p L) a : 𝒪 p L) : L)

theorem teichmullerSet_pow_q {x : L} (hx : x ∈ teichmullerSet p L) : x ^ q p L = x := by
  obtain ⟨a, rfl⟩ := hx
  rw [← Integers.coe_pow]
  exact congrArg _ (Teichmuller.teichmuller_pow_Q a)

omit [FiniteDimensional ℚ_[p] K] in
/-- The residue field of the subfield generated by the Teichmüller representatives is everything.
-/
theorem f_adjoin_teichmullerSet_eq_one :
    f p (IntermediateField.adjoin K (teichmullerSet p L)) L = 1 := by
  set E := IntermediateField.adjoin K (teichmullerSet p L)
  refine f_eq_one_of_forall_exists fun y ↦ ?_
  set a := residue (𝒪 p L) y
  set ω := (Teichmuller.teichmuller (𝒪 p L) a : 𝒪 p L)
  have hmem : (ω : L) ∈ E := IntermediateField.subset_adjoin _ _ ⟨a, rfl⟩
  let x : E := ⟨ω, hmem⟩
  have hx : nrm p E x ≤ 1 := by
    rw [← nrm_algebraMap_tower (L := L)]; exact Integers.nrm_coe_le_one ω
  refine ⟨Integers.mk x hx, ?_⟩
  have : algebraMap (𝒪 p E) (𝒪 p L) (Integers.mk x hx) = ω := Integers.ext rfl
  rw [this, ← residue_eq_zero_iff, map_sub, Teichmuller.residue_teichmuller, sub_self]

/-- An unramified extension is generated by Teichmüller representatives. -/
theorem adjoin_teichmullerSet_eq_top (h : IsUnramified p K L) :
    IntermediateField.adjoin K (teichmullerSet p L) = ⊤ := by
  haveI := finiteDimensional_tower (p := p) K L
  set E := IntermediateField.adjoin K (teichmullerSet p L)
  have hf : f p K E = f p K L := by
    rw [← f_mul_f (p := p) (K := K) (E := E) (L := L), f_adjoin_teichmullerSet_eq_one, mul_one]
  have hle : Module.finrank K L ≤ Module.finrank K E := by
    rw [← h.f_eq, ← hf, ← e_mul_f (p := p) (K := K) (L := E)]
    exact Nat.le_mul_of_pos_left _ e_pos
  exact IntermediateField.eq_of_le_of_finrank_le le_top
    (by rw [IntermediateField.finrank_top']; exact hle)

omit [Algebra ℚ_[p] K] [IsScalarTower ℚ_[p] K L] [FiniteDimensional ℚ_[p] K] in
theorem card_roots_X_pow_q_sub_X :
    ((X ^ q p L - X : K[X]).map (algebraMap K L)).roots.card = q p L := by
  have hq := one_lt_q p L
  have hdeg : ((X ^ q p L - X : K[X]).map (algebraMap K L)).natDegree = q p L := by
    rw [Polynomial.map_sub, Polynomial.map_pow, map_X, natDegree_sub_eq_left_of_natDegree_lt]
    · simp
    · simpa using hq
  refine le_antisymm ((card_roots' _).trans hdeg.le) ?_
  classical
  have hne : ((X ^ q p L - X : K[X]).map (algebraMap K L)) ≠ 0 := by
    intro h0; rw [h0, natDegree_zero] at hdeg; omega
  haveI := Fintype.ofFinite (𝓴 p L)
  calc q p L = (Finset.univ.image fun a : 𝓴 p L ↦
        ((Teichmuller.teichmuller (𝒪 p L) a : 𝒪 p L) : L)).card := by
          rw [Finset.card_image_of_injective _ fun a b hab ↦
            Teichmuller.teichmuller_injective (Integers.ext hab), Finset.card_univ, q,
            Nat.card_eq_fintype_card]
    _ ≤ ((X ^ q p L - X : K[X]).map (algebraMap K L)).roots.toFinset.card := by
          refine Finset.card_le_card fun x hx ↦ ?_
          obtain ⟨a, -, rfl⟩ := Finset.mem_image.1 hx
          rw [Multiset.mem_toFinset, mem_roots hne, IsRoot, Polynomial.map_sub,
            Polynomial.map_pow, map_X, eval_sub, eval_pow, eval_X,
            teichmullerSet_pow_q ⟨a, rfl⟩, sub_self]
    _ ≤ _ := Multiset.toFinset_card_le _

omit [Algebra ℚ_[p] K] [IsScalarTower ℚ_[p] K L] [FiniteDimensional ℚ_[p] K] in
theorem teichmullerSet_subset_rootSet :
    teichmullerSet p L ⊆ (X ^ q p L - X : K[X]).rootSet L := by
  intro x hx
  have hq := one_lt_q p L
  rw [mem_rootSet]
  refine ⟨?_, ?_⟩
  · intro h0
    have := congrArg natDegree h0
    rw [natDegree_sub_eq_left_of_natDegree_lt (by simpa using hq)] at this
    simp at this; omega
  · simp [teichmullerSet_pow_q hx]

/-- An unramified extension is the splitting field of `X ^ Q - X`. -/
theorem isSplittingField_of_isUnramified (h : IsUnramified p K L) :
    IsSplittingField K L (X ^ q p L - X : K[X]) := by
  rw [isSplittingField_iff_intermediateField]
  refine ⟨?_, ?_⟩
  · rw [splits_iff_card_roots, card_roots_X_pow_q_sub_X, Polynomial.map_sub, Polynomial.map_pow,
      map_X, natDegree_sub_eq_left_of_natDegree_lt]
    · simp
    · simpa using one_lt_q p L
  · exact top_le_iff.1 ((adjoin_teichmullerSet_eq_top h).symm.le.trans
      (IntermediateField.adjoin.mono _ _ _ teichmullerSet_subset_rootSet))

/-- An unramified extension is Galois. -/
theorem isGalois_of_isUnramified (h : IsUnramified p K L) : IsGalois K L := by
  haveI := isSplittingField_of_isUnramified h
  haveI := charZero p K
  haveI := finiteDimensional_tower (p := p) K L
  haveI := Normal.of_isSplittingField (F := K) (E := L) (X ^ q p L - X)
  exact ⟨⟩

end PadicField
