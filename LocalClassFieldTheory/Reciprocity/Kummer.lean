import LocalClassFieldTheory.Reciprocity.Existence
import ContinuousKummerTheory.Kummer.PAdic

/-!
# The existence theorem in the Kummer case

Let `K` contain a primitive `n`-th root of unity. The Kummer field `L = K((Kˣ)^{1/n}) ⊆ Ω`
(generated by `n`-th roots of a finite system of representatives of `Kˣ/(Kˣ)ⁿ`, which is finite
by `KummerTheory.finiteKummerQuotients_of_isDiscreteValuationRing`) is finite abelian over `K`,
of exponent dividing `n`, and `N_{L/K} Lˣ = (Kˣ)ⁿ`.

Proof of the last equality: `(Kˣ)ⁿ ⊆ N_{L/K} Lˣ` since `Gal(L/K)` has exponent dividing `n`.
Conversely the Kummer map `x ↦ (σ ↦ σ(ⁿ√x)/ⁿ√x)`, `Kˣ → Hom(Gal(L/K), Lˣ)`, has kernel in
`(Kˣ)ⁿ`, so `[Kˣ : (Kˣ)ⁿ] ≤ |Hom(Gal(L/K), Lˣ)| = |Gal(L/K)| = [Kˣ : N_{L/K} Lˣ]`.

* `PadicField.normGroup_eq_pow_of_kummer`: `N_{L/K} Lˣ = (Kˣ)ⁿ` for any finite Galois `L`
  generated by `n`-th roots of elements of `K` and containing an `n`-th root of every element;
* `PadicField.exists_abFin_normGroup_eq_pow`, `PadicField.exists_abFin_normGroup_le_pow`: the
  existence theorem for `(Kˣ)ⁿ` when `μ_n ⊆ K`.
-/

set_option linter.unusedSectionVars false

open IntermediateField Polynomial

namespace PadicField

variable {p : ℕ} [hp : Fact p.Prime]
variable {K : Type*} [Field K] [Algebra ℚ_[p] K] [FiniteDimensional ℚ_[p] K]
variable {Ω : Type*} [Field Ω] [Algebra K Ω] [Algebra ℚ_[p] Ω] [IsScalarTower ℚ_[p] K Ω]
  [IsAlgClosed Ω]

section Generic

variable {n : ℕ} {ζ : K} (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n)
variable {L : IntermediateField K Ω}

include hζ hn in
/-- If `μ_n ⊆ K`, every `n`-th root of unity in `L ⊆ Ω` is fixed by `Gal(L/K)`. -/
theorem kummer_fix_of_pow_eq_one (u : L) (hu : u ^ n = 1) (σ : L ≃ₐ[K] L) : σ u = u := by
  haveI : NeZero n := ⟨hn.ne'⟩
  have hζ' := hζ.map_of_injective (algebraMap K Ω).injective
  obtain ⟨i, -, hi⟩ := hζ'.eq_pow_of_pow_eq_one (ξ := (u : Ω))
    (by rw [← IntermediateField.coe_pow, hu]; rfl)
  have : u = algebraMap K L (ζ ^ i) := Subtype.ext (by rw [← hi]; simp)
  rw [this, AlgEquiv.commutes]

include hζ hn in
/-- For `r ∈ Lˣ` with `rⁿ ∈ K`, `σ r / r` is fixed by `Gal(L/K)`. -/
theorem kummer_fix_div (r : Lˣ) (hr : ∃ a : K, algebraMap K L a = (r : L) ^ n)
    (σ τ : L ≃ₐ[K] L) : τ (σ r * (r : L)⁻¹) = σ r * (r : L)⁻¹ := by
  refine kummer_fix_of_pow_eq_one hζ hn _ ?_ τ
  obtain ⟨a, ha⟩ := hr
  rw [mul_pow, ← map_pow, ← ha, AlgEquiv.commutes, ha, inv_pow, mul_inv_cancel₀]
  exact pow_ne_zero _ r.ne_zero

include hζ hn in
/-- `σ τ r = τ σ r` for `rⁿ ∈ K`. -/
theorem kummer_comm_apply (r : Lˣ) (hr : ∃ a : K, algebraMap K L a = (r : L) ^ n)
    (σ τ : L ≃ₐ[K] L) : σ (τ r) = τ (σ r) := by
  obtain ⟨a, ha⟩ : ∃ a, a = τ r * (r : L)⁻¹ := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b, b = σ r * (r : L)⁻¹ := ⟨_, rfl⟩
  have hσa : σ a = a := ha ▸ kummer_fix_div hζ hn r hr τ σ
  have hτb : τ b = b := hb ▸ kummer_fix_div hζ hn r hr σ τ
  have h1 : τ r = a * r := by rw [ha, inv_mul_cancel_right₀ r.ne_zero]
  have h2 : σ r = b * r := by rw [hb, inv_mul_cancel_right₀ r.ne_zero]
  rw [h1, h2, map_mul, map_mul, hσa, hτb, h1, h2, mul_left_comm]

include hζ hn in
/-- `σⁿ r = r` for `rⁿ ∈ K`. -/
theorem kummer_pow_apply (r : Lˣ) (hr : ∃ a : K, algebraMap K L a = (r : L) ^ n)
    (σ : L ≃ₐ[K] L) : (σ ^ n) r = r := by
  set u := σ r * (r : L)⁻¹
  have hσ : σ r = u * r := by rw [inv_mul_cancel_right₀ r.ne_zero]
  have hk : ∀ k : ℕ, (σ ^ k) r = u ^ k * r := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, AlgEquiv.mul_apply, hσ, map_mul, ih,
        show (σ ^ k) u = u from kummer_fix_div hζ hn r hr σ _, pow_succ]
      ring
  have hun : u ^ n = 1 := by
    obtain ⟨a, ha⟩ := hr
    rw [mul_pow, ← map_pow, ← ha, AlgEquiv.commutes, ha, inv_pow, mul_inv_cancel₀]
    exact pow_ne_zero _ r.ne_zero
  rw [hk, hun, one_mul]

variable (K) in
/-- The generators of a Kummer extension. -/
def KummerGen (n : ℕ) (T : Set Ω) : Prop := ∀ z ∈ T, z ≠ 0 ∧ ∃ a : K, algebraMap K Ω a = z ^ n

include hζ hn in
/-- A field generated by `n`-th roots of elements of `K` is abelian of exponent dividing `n`. -/
theorem kummer_comm_and_pow {T : Set Ω} (hT : KummerGen K n T) (hL : L = adjoin K T)
    (σ τ : L ≃ₐ[K] L) : σ * τ = τ * σ ∧ σ ^ n = 1 := by
  have hgen : ∀ z (hz : z ∈ T), ∃ a : K, algebraMap K L a =
      ((Units.mk0 (⟨z, hL.ge (subset_adjoin _ _ hz)⟩ : L)
        (fun h ↦ (hT z hz).1 (congrArg Subtype.val h)) : Lˣ) : L) ^ n := by
    intro z hz
    obtain ⟨a, ha⟩ := (hT z hz).2
    exact ⟨a, Subtype.ext (by simpa using ha)⟩
  constructor
  · have := algHom_ext_of_eq_adjoin (F := K) (K := L) hL
      (φ₁ := (σ * τ : L ≃ₐ[K] L).toAlgHom) (φ₂ := (τ * σ : L ≃ₐ[K] L).toAlgHom)
      fun z hz ↦ kummer_comm_apply hζ hn _ (hgen z hz) σ τ
    exact AlgEquiv.ext fun x ↦ DFunLike.congr_fun this x
  · have := algHom_ext_of_eq_adjoin (F := K) (K := L) hL
      (φ₁ := (σ ^ n : L ≃ₐ[K] L).toAlgHom) (φ₂ := AlgHom.id K L)
      fun z hz ↦ kummer_pow_apply hζ hn _ (hgen z hz) σ
    exact AlgEquiv.ext fun x ↦ DFunLike.congr_fun this x

include hζ hn in
theorem kummer_isAbelianGalois [FiniteDimensional K L] [IsGalois K L] {T : Set Ω}
    (hT : KummerGen K n T) (hL : L = adjoin K T) : IsAbelianGalois K L where
  is_comm := ⟨fun σ τ ↦ (kummer_comm_and_pow hζ hn hT hL σ τ).1⟩

/-- The Kummer map `r ↦ (σ ↦ σ r / r)`. -/
noncomputable def kummerAux (L : IntermediateField K Ω) : Lˣ →* ((L ≃ₐ[K] L) → Lˣ) where
  toFun r σ := Units.map (σ : L →* L) r * r⁻¹
  map_one' := by ext; simp
  map_mul' r s := by ext σ; simp only [map_mul, Pi.mul_apply, mul_inv]; ac_rfl

theorem kummerAux_apply (r : Lˣ) (σ : L ≃ₐ[K] L) :
    ((kummerAux L r σ : Lˣ) : L) = σ r * (r : L)⁻¹ := by
  simp [kummerAux, Units.val_inv_eq_inv_val]

include hζ hn in
theorem kummerAux_mul (r : Lˣ) (hr : ∃ a : K, algebraMap K L a = (r : L) ^ n)
    (σ τ : L ≃ₐ[K] L) : kummerAux L r (σ * τ) = kummerAux L r σ * kummerAux L r τ := by
  apply Units.ext
  simp only [Units.val_mul, kummerAux_apply, AlgEquiv.mul_apply]
  obtain ⟨a, ha⟩ : ∃ a, a = τ r * (r : L)⁻¹ := ⟨_, rfl⟩
  have hσa : σ a = a := ha ▸ kummer_fix_div hζ hn r hr τ σ
  have h1 : τ r = a * r := by rw [ha, inv_mul_cancel_right₀ r.ne_zero]
  rw [h1, map_mul, hσa, mul_inv_cancel_right₀ r.ne_zero]
  ring

include hζ hn in
theorem kummerAux_eq_one_of_pow_eq_one (u : Lˣ) (hu : u ^ n = 1) : kummerAux L u = 1 := by
  funext σ
  apply Units.ext
  rw [kummerAux_apply, kummer_fix_of_pow_eq_one hζ hn (u : L)
    (by rw [← Units.val_pow_eq_pow_val, hu, Units.val_one]) σ, mul_inv_cancel₀ u.ne_zero]
  rfl

/-- The subgroup `(Kˣ)ⁿ`. -/
abbrev powGroup (K : Type*) [Field K] (n : ℕ) : Subgroup Kˣ := (powMonoidHom n : Kˣ →* Kˣ).range

include hp hζ hn in
/-- **Norm groups of Kummer extensions**: if `μ_n ⊆ K` and `L ⊆ Ω` is finite Galois, generated
by `n`-th roots of elements of `K`, and contains an `n`-th root of every element of `K`, then
`N_{L/K} Lˣ = (Kˣ)ⁿ`. -/
theorem normGroup_eq_pow_of_kummer [FiniteDimensional K L] [IsGalois K L] {T : Set Ω}
    (hT : KummerGen K n T) (hL : L = adjoin K T)
    (hroot : ∀ x : Kˣ, ∃ r : L, r ^ n = algebraMap K L x) :
    haveI := kummer_isAbelianGalois hζ hn hT hL
    normGroup K L = powGroup K n := by
  haveI := kummer_isAbelianGalois hζ hn hT hL
  haveI : NeZero n := ⟨hn.ne'⟩
  set G := L ≃ₐ[K] L
  letI : CommGroup G :=
    { (inferInstance : Group G) with
      mul_comm := fun σ τ ↦ (kummer_comm_and_pow hζ hn hT hL σ τ).1 }
  -- `(Kˣ)ⁿ ⊆ N_{L/K} Lˣ`
  have hle : powGroup K n ≤ normGroup K L := by
    rintro _ ⟨y, rfl⟩
    rw [← ker_abRec (p := p), MonoidHom.mem_ker, powMonoidHom_apply, map_pow]
    exact (kummer_comm_and_pow hζ hn hT hL (abRec p L y) 1).2
  -- the Kummer map
  have hr0 : ∀ x : Kˣ, (hroot x).choose ≠ 0 := by
    intro x h
    have := (hroot x).choose_spec
    rw [h, zero_pow hn.ne'] at this
    exact x.ne_zero ((algebraMap K L).injective (by rw [← this, map_zero]))
  let root : Kˣ → Lˣ := fun x ↦ Units.mk0 _ (hr0 x)
  have hroot' : ∀ x, ((root x : L)) ^ n = algebraMap K L x := fun x ↦ (hroot x).choose_spec
  have hrK : ∀ x, ∃ a : K, algebraMap K L a = (root x : L) ^ n := fun x ↦ ⟨x, (hroot' x).symm⟩
  let F : Kˣ →* (G →* Lˣ) :=
    { toFun := fun x ↦
        { toFun := kummerAux L (root x)
          map_one' := by apply Units.ext; simp [kummerAux_apply]
          map_mul' := kummerAux_mul hζ hn _ (hrK x) }
      map_one' := by
        ext1 σ
        change kummerAux L (root 1) σ = 1
        rw [kummerAux_eq_one_of_pow_eq_one hζ hn (root 1)
          (Units.ext (by simp [hroot' 1]))]
        rfl
      map_mul' := fun x y ↦ by
        ext1 σ
        change kummerAux L (root (x * y)) σ = kummerAux L (root x) σ * kummerAux L (root y) σ
        have hu : (root (x * y) * (root x * root y)⁻¹) ^ n = 1 := by
          apply Units.ext
          simp only [mul_pow, inv_pow, Units.val_mul, Units.val_pow_eq_pow_val,
            Units.val_inv_eq_inv_val, hroot', Units.val_one, map_mul]
          rw [mul_inv_cancel₀]
          simp
        have := kummerAux_eq_one_of_pow_eq_one hζ hn _ hu
        rw [map_mul, map_inv, mul_inv_eq_one, map_mul] at this
        rw [this]
        rfl }
  have hFker : F.ker ≤ powGroup K n := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hfix : ∀ σ : G, σ (root x) = root x := by
      intro σ
      have := congrArg Units.val (DFunLike.congr_fun hx σ)
      change σ (root x) * (root x : L)⁻¹ = 1 at this
      rwa [mul_inv_eq_one₀ (Units.ne_zero _)] at this
    obtain ⟨y, hy⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (root x : L)).2 hfix
    have hy0 : y ≠ 0 := by
      rintro rfl; rw [map_zero] at hy; exact Units.ne_zero _ hy.symm
    refine ⟨Units.mk0 y hy0, Units.ext ((algebraMap K L).injective ?_)⟩
    rw [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, map_pow, hy, hroot']
  -- counting
  haveI : HasEnoughRootsOfUnity L n :=
    ⟨⟨algebraMap K L ζ, hζ.map_of_injective (algebraMap K L).injective⟩, inferInstance⟩
  haveI : HasEnoughRootsOfUnity L (Monoid.exponent G) :=
    HasEnoughRootsOfUnity.of_dvd L (Monoid.exponent_dvd_of_forall_pow_eq_one
      fun σ ↦ (kummer_comm_and_pow hζ hn hT hL σ 1).2)
  haveI : Finite (G →* Lˣ) :=
    Finite.of_equiv G (CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity G L).some.toEquiv.symm
  have hcard : Nat.card (G →* Lˣ) = Nat.card G :=
    CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity G L
  have hN : (normGroup K L).index = Nat.card G := by
    rw [Subgroup.index]
    exact Nat.card_congr (abRecEquiv (p := p) L).toEquiv
  have hFindex : F.ker.index ≤ (normGroup K L).index := by
    rw [Subgroup.index_ker, hN, ← hcard]
    exact Subgroup.card_le_card_group _
  have hFne : F.ker.index ≠ 0 := by
    rw [Subgroup.index_ker]; exact Nat.card_pos.ne'
  have hPne : (powGroup K n).index ≠ 0 := fun h ↦ hFne (Nat.eq_zero_of_zero_dvd
    (h ▸ Subgroup.index_dvd_of_le hFker))
  have hPle : (powGroup K n).index ≤ (normGroup K L).index :=
    (Nat.le_of_dvd (Nat.pos_of_ne_zero hFne) (Subgroup.index_dvd_of_le hFker)).trans hFindex
  have hrel := Subgroup.relIndex_mul_index hle
  have hNne : (normGroup K L).index ≠ 0 := by rw [hN]; exact Nat.card_pos.ne'
  have h1 : (powGroup K n).relIndex (normGroup K L) = 1 := by
    have hpos : 0 < (powGroup K n).relIndex (normGroup K L) := by
      rcases Nat.eq_zero_or_pos ((powGroup K n).relIndex (normGroup K L)) with h | h
      · rw [h, zero_mul] at hrel; exact absurd hrel.symm hPne
      · exact h
    by_contra h
    have : 2 * (normGroup K L).index ≤ (powGroup K n).index := by
      rw [← hrel]; exact Nat.mul_le_mul_right _ (by omega)
    omega
  exact le_antisymm (Subgroup.relIndex_eq_one.1 h1) hle

end Generic

include hp in
/-- **Existence theorem in the Kummer case**: if `μ_n ⊆ K`, then `(Kˣ)ⁿ` is the norm group of a
finite abelian extension (the Kummer field `K((Kˣ)^{1/n})`). -/
theorem exists_abFin_normGroup_eq_pow (n : ℕ) (hn : 0 < n) (hζ : ∃ ζ : K, IsPrimitiveRoot ζ n) :
    ∃ L : AbFin K Ω, normGroup K L.1 = powGroup K n := by
  classical
  obtain ⟨ζ, hζ⟩ := hζ
  haveI : CharZero K := charZero_of_injective_algebraMap (algebraMap ℚ_[p] K).injective
  haveI := (KummerTheory.finiteKummerQuotients_of_isDiscreteValuationRing (𝒪 p K) K).finiteIndex
    n hn.ne'
  haveI : Finite (Kˣ ⧸ powGroup K n) := Subgroup.finite_quotient_of_finiteIndex
  letI := Fintype.ofFinite (Kˣ ⧸ powGroup K n)
  obtain ⟨f, hf⟩ : ∃ f : K[X],
      f = ∏ c : Kˣ ⧸ powGroup K n, (X ^ n - C ((Quotient.out c : Kˣ) : K)) := ⟨_, rfl⟩
  have hf0 : f ≠ 0 := hf ▸ Finset.prod_ne_zero_iff.2 fun c _ ↦ X_pow_sub_C_ne_zero hn _
  have hmem : ∀ z : Ω, z ∈ f.rootSet Ω ↔
      ∃ c : Kˣ ⧸ powGroup K n, z ^ n = algebraMap K Ω ((Quotient.out c : Kˣ) : K) := by
    intro z
    rw [mem_rootSet, and_iff_right hf0, hf, map_prod, Finset.prod_eq_zero_iff]
    simp [sub_eq_zero]
  set T := f.rootSet Ω
  obtain ⟨L, hL⟩ : ∃ L : IntermediateField K Ω, L = adjoin K T := ⟨_, rfl⟩
  have hsplit : (f.map (algebraMap K Ω)).Splits := IsAlgClosed.splits _
  haveI : f.IsSplittingField K L := hL ▸ adjoin_rootSet_isSplittingField hsplit
  haveI : FiniteDimensional K L := IsSplittingField.finiteDimensional L f
  haveI : Normal K L := Normal.of_isSplittingField f
  haveI : IsGalois K L := {}
  have hT : KummerGen K n T := by
    intro z hz
    obtain ⟨c, hc⟩ := (hmem z).1 hz
    refine ⟨fun h0 ↦ ?_, _, hc.symm⟩
    rw [h0, zero_pow hn.ne', eq_comm, map_eq_zero_iff _ (algebraMap K Ω).injective] at hc
    exact (Quotient.out c).ne_zero hc
  have hroot : ∀ x : Kˣ, ∃ r : L, r ^ n = algebraMap K L x := by
    intro x
    obtain ⟨⟨_, w, rfl⟩, hh⟩ := QuotientGroup.mk_out_eq_mul (powGroup K n) x
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq
      (algebraMap K Ω ((Quotient.out (QuotientGroup.mk x : Kˣ ⧸ powGroup K n) : Kˣ) : K)) hn
    have hzT : z ∈ T := (hmem z).2 ⟨_, hz⟩
    refine ⟨⟨z, hL ▸ subset_adjoin K T hzT⟩ * algebraMap K L ((w⁻¹ : Kˣ) : K), ?_⟩
    apply Subtype.ext
    simp only [IntermediateField.coe_pow, IntermediateField.coe_mul, mul_pow,
      IntermediateField.coe_algebraMap_apply]
    rw [hz, ← map_pow, ← map_mul, ← Units.val_pow_eq_pow_val, ← Units.val_mul, hh]
    simp [powMonoidHom_apply]
  have hab := kummer_isAbelianGalois hζ hn hT hL
  exact ⟨⟨L, inferInstance, hab⟩, normGroup_eq_pow_of_kummer (p := p) hζ hn hT hL hroot⟩

include hp in
/-- **Existence theorem in the Kummer case**, in the form used by `existence_of_pow`. -/
theorem exists_abFin_normGroup_le_pow (n : ℕ) (hn : 0 < n) (hζ : ∃ ζ : K, IsPrimitiveRoot ζ n) :
    ∃ L : AbFin K Ω, ∀ x ∈ normGroup K L.1, ∃ y : Kˣ, y ^ n = x := by
  obtain ⟨L, hL⟩ := exists_abFin_normGroup_eq_pow (p := p) (Ω := Ω) n hn hζ
  refine ⟨L, fun x hx ↦ ?_⟩
  rw [hL] at hx
  obtain ⟨y, rfl⟩ := hx
  exact ⟨y, rfl⟩

end PadicField
