import LocalClassFieldTheory.Reciprocity.SecondInequality
import LocalClassFieldTheory.PadicField.UnramifiedExistence

/-!
# Standard extensions `F = M · U`

Let `M/K` be totally ramified Galois and `U/K` unramified, both inside `F` with
`[F : K] = [M : K] [U : K]`. Then (`PadicField.Std...`):

* `F` is generated by `M` and `U` (any intermediate field containing both is everything);
* `F/M` is unramified and `F/U` is totally ramified;
* restriction `Gal(F/U) → Gal(M/K)` and `Gal(F/M) → Gal(U/K)` are bijective;
* norms: `N_{F/M}(a) = N_{U/K}(a)` for `a ∈ U` and `N_{F/U}(m) = N_{M/K}(m)` for `m ∈ M`.
-/

set_option linter.unusedSectionVars false

namespace PadicField

variable {p : ℕ} [hp : Fact p.Prime]

section AlgHom

variable {K M E : Type*} [Field K] [Field M] [Field E] [Algebra ℚ_[p] K] [Algebra ℚ_[p] M]
  [Algebra ℚ_[p] E] [Algebra K M] [Algebra K E] [IsScalarTower ℚ_[p] K M]
  [IsScalarTower ℚ_[p] K E] [FiniteDimensional ℚ_[p] K] [FiniteDimensional ℚ_[p] M]
  [FiniteDimensional ℚ_[p] E]

theorem e_dvd_of_algHom (φ : M →ₐ[K] E) : e p K M ∣ e p K E := by
  letI : Algebra M E := φ.toAlgebra
  haveI : IsScalarTower K M E := IsScalarTower.of_algebraMap_eq fun x ↦ (φ.commutes x).symm
  haveI : IsScalarTower ℚ_[p] M E := IsScalarTower.of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply ℚ_[p] K M, IsScalarTower.algebraMap_apply ℚ_[p] K E]
    exact (φ.commutes _).symm
  exact ⟨_, (e_mul_e (p := p) (K := K) (E := M) (L := E)).symm⟩

theorem f_dvd_of_algHom (φ : M →ₐ[K] E) : f p K M ∣ f p K E := by
  letI : Algebra M E := φ.toAlgebra
  haveI : IsScalarTower K M E := IsScalarTower.of_algebraMap_eq fun x ↦ (φ.commutes x).symm
  haveI : IsScalarTower ℚ_[p] M E := IsScalarTower.of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply ℚ_[p] K M, IsScalarTower.algebraMap_apply ℚ_[p] K E]
    exact (φ.commutes _).symm
  exact ⟨_, (f_mul_f (p := p) (K := K) (E := M) (L := E)).symm⟩

end AlgHom

/-- If `a x = x` then `a ^ k x = x` for all integers `k`. -/
theorem zpow_apply_eq_of_apply_eq {K F : Type*} [Field K] [Field F] [Algebra K F]
    {a : F ≃ₐ[K] F} {x : F} (h : a x = x) (k : ℤ) : (a ^ k) x = x := by
  let S : Subgroup (F ≃ₐ[K] F) :=
    { carrier := {b | b x = x}
      one_mem' := rfl
      mul_mem' := fun {b c} hb hc ↦ by
        simp only [Set.mem_setOf_eq, AlgEquiv.mul_apply] at *; rw [hc, hb]
      inv_mem' := fun {b} hb ↦ by
        simp only [Set.mem_setOf_eq] at *
        rw [AlgEquiv.aut_inv]; exact (b.symm_apply_eq).2 hb.symm }
  exact (Subgroup.zpowers_le.2 (show a ∈ S from h)) (Subgroup.zpow_mem_zpowers a k)

section Std

variable {K M U F : Type*} [Field K] [Field M] [Field U] [Field F]
  [Algebra ℚ_[p] K] [Algebra ℚ_[p] M] [Algebra ℚ_[p] U] [Algebra ℚ_[p] F]
  [Algebra K M] [Algebra K U] [Algebra K F] [Algebra M F] [Algebra U F]
  [IsScalarTower ℚ_[p] K M] [IsScalarTower ℚ_[p] K U] [IsScalarTower ℚ_[p] K F]
  [IsScalarTower ℚ_[p] M F] [IsScalarTower ℚ_[p] U F]
  [IsScalarTower K M F] [IsScalarTower K U F]
  [FiniteDimensional ℚ_[p] K] [FiniteDimensional ℚ_[p] M] [FiniteDimensional ℚ_[p] U]
  [FiniteDimensional ℚ_[p] F]

variable (hM : e p K M = Module.finrank K M) (hU : IsUnramified p K U)
  (hdeg : Module.finrank K F = Module.finrank K M * Module.finrank K U)
include hM hU hdeg

theorem std_e : e p K F = Module.finrank K M ∧ f p K F = Module.finrank K U := by
  haveI := finiteDimensional_tower (p := p) K M
  haveI := finiteDimensional_tower (p := p) K U
  have h1 : e p K M ∣ e p K F := e_dvd_of_algHom (IsScalarTower.toAlgHom K M F)
  have h2 : f p K U ∣ f p K F := f_dvd_of_algHom (IsScalarTower.toAlgHom K U F)
  rw [hM] at h1
  rw [hU.f_eq] at h2
  have hef := e_mul_f (p := p) (K := K) (L := F)
  rw [hdeg] at hef
  have hMpos : 0 < Module.finrank K M := Module.finrank_pos
  have hUpos : 0 < Module.finrank K U := Module.finrank_pos
  have hle1 := Nat.le_of_dvd (e_pos (p := p) (K := K) (L := F)) h1
  have hle2 := Nat.le_of_dvd (f_pos (p := p) (K := K) (L := F)) h2
  constructor
  · by_contra hne
    have : Module.finrank K M < e p K F := lt_of_le_of_ne hle1 (Ne.symm hne)
    have := Nat.mul_lt_mul_of_lt_of_le this hle2 (f_pos (p := p) (K := K) (L := F))
    omega
  · by_contra hne
    have : Module.finrank K U < f p K F := lt_of_le_of_ne hle2 (Ne.symm hne)
    have := Nat.mul_lt_mul_of_le_of_lt hle1 this (e_pos (p := p) (K := K) (L := F))
    omega

/-- `F/M` is unramified. -/
theorem std_isUnramified_top : IsUnramified p M F := by
  have he := (std_e hM hU hdeg).1
  have h1 := e_mul_e (p := p) (K := K) (E := M) (L := F)
  rw [he, hM] at h1
  haveI := finiteDimensional_tower (p := p) K M
  exact (Nat.mul_eq_left Module.finrank_pos.ne').1 h1

/-- `F/U` is totally ramified, of degree `[M : K]`. -/
theorem std_finrank_U : Module.finrank U F = Module.finrank K M := by
  haveI := finiteDimensional_tower (p := p) K U
  have := Module.finrank_mul_finrank K U F
  rw [hdeg, mul_comm] at this
  exact (Nat.mul_right_cancel Module.finrank_pos this.symm).symm

theorem std_finrank_M : Module.finrank M F = Module.finrank K U := by
  haveI := finiteDimensional_tower (p := p) K M
  have := Module.finrank_mul_finrank K M F
  rw [hdeg] at this
  exact Nat.mul_left_cancel Module.finrank_pos this

theorem std_e_U : e p U F = Module.finrank U F := by
  have he := (std_e hM hU hdeg).1
  have := e_mul_e (p := p) (K := K) (E := U) (L := F)
  rw [he, hU] at this
  rw [std_finrank_U hM hU hdeg]; omega

/-- `F` is generated by `M` and `U`. -/
theorem std_eq_top (E : IntermediateField K F) (hME : ∀ m : M, algebraMap M F m ∈ E)
    (hUE : ∀ u : U, algebraMap U F u ∈ E) : E = ⊤ := by
  haveI := finiteDimensional_tower (p := p) K F
  let φM : M →ₐ[K] E :=
    { toFun := fun m ↦ ⟨algebraMap M F m, hME m⟩
      map_one' := by ext; simp
      map_mul' := fun a b ↦ by ext; simp
      map_zero' := by ext; simp
      map_add' := fun a b ↦ by ext; simp
      commutes' := fun k ↦ by ext; simp [← IsScalarTower.algebraMap_apply] }
  let φU : U →ₐ[K] E :=
    { toFun := fun m ↦ ⟨algebraMap U F m, hUE m⟩
      map_one' := by ext; simp
      map_mul' := fun a b ↦ by ext; simp
      map_zero' := by ext; simp
      map_add' := fun a b ↦ by ext; simp
      commutes' := fun k ↦ by ext; simp [← IsScalarTower.algebraMap_apply] }
  have h1 := e_dvd_of_algHom (p := p) φM
  have h2 := f_dvd_of_algHom (p := p) φU
  rw [hM] at h1
  rw [hU.f_eq] at h2
  have hle : Module.finrank K F ≤ Module.finrank K E := by
    rw [hdeg, ← e_mul_f (p := p) (K := K) (L := E)]
    exact Nat.mul_le_mul (Nat.le_of_dvd e_pos h1) (Nat.le_of_dvd f_pos h2)
  exact IntermediateField.eq_of_le_of_finrank_le le_top
    (by rw [IntermediateField.finrank_top']; exact hle) |>.trans rfl


section Galois

variable [IsGalois K F] [IsGalois K M]

omit hM hU hdeg in
/-- Restriction `Gal(F/U) → Gal(M/K)`. -/
noncomputable def stdResM : (F ≃ₐ[U] F) →* (M ≃ₐ[K] M) :=
  (AlgEquiv.restrictNormalHom (F := K) (K₁ := F) M).comp
    { toFun := fun g ↦ g.restrictScalars K
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }

omit hM hU hdeg in
/-- Restriction `Gal(F/M) → Gal(U/K)`. -/
noncomputable def stdResU (hU : IsUnramified p K U) : (F ≃ₐ[M] F) →* (U ≃ₐ[K] U) :=
  haveI := isGalois_of_isUnramified hU
  (AlgEquiv.restrictNormalHom (F := K) (K₁ := F) U).comp
    { toFun := fun g ↦ g.restrictScalars K
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }

omit hM hU hdeg in
theorem stdResM_apply (g : F ≃ₐ[U] F) (m : M) :
    algebraMap M F (stdResM (K := K) (U := U) g m) = g (algebraMap M F m) :=
  AlgEquiv.restrictNormal_commutes (g.restrictScalars K) M m

omit hM hU hdeg in
theorem stdResU_apply (hU : IsUnramified p K U) (g : F ≃ₐ[M] F) (u : U) :
    algebraMap U F (stdResU hU g u) = g (algebraMap U F u) := by
  haveI := isGalois_of_isUnramified hU
  exact AlgEquiv.restrictNormal_commutes (g.restrictScalars K) U u

theorem stdResM_bijective : Function.Bijective (stdResM (K := K) (M := M) (U := U) (F := F)) := by
  haveI := finiteDimensional_tower (p := p) K M
  haveI := finiteDimensional_tower (p := p) K F
  haveI := finiteDimensional_tower (p := p) U F
  haveI : IsGalois U F := IsGalois.tower_top_of_isGalois K U F
  have hinj : Function.Injective (stdResM (K := K) (M := M) (U := U) (F := F)) := by
    rw [injective_iff_map_eq_one]
    intro g hg
    have hE := std_eq_top hM hU hdeg
      (IntermediateField.fixedField (Subgroup.zpowers (g.restrictScalars K)))
      (fun m ↦ by
        rintro ⟨_, k, rfl⟩
        change (g.restrictScalars K ^ k) (algebraMap M F m) = _
        have : g.restrictScalars K (algebraMap M F m) = algebraMap M F m := by
          have h := stdResM_apply (K := K) g m
          rw [hg, AlgEquiv.one_apply] at h
          exact h.symm
        exact zpow_apply_eq_of_apply_eq this k)
      (fun u ↦ by
        rintro ⟨_, k, rfl⟩
        have : g.restrictScalars K (algebraMap U F u) = algebraMap U F u := g.commutes u
        change (g.restrictScalars K ^ k) (algebraMap U F u) = _
        exact zpow_apply_eq_of_apply_eq this k)
    ext x
    have hx : x ∈ IntermediateField.fixedField (Subgroup.zpowers (g.restrictScalars K)) :=
      hE ▸ IntermediateField.mem_top
    exact hx ⟨g.restrictScalars K, Subgroup.mem_zpowers _⟩
  refine hinj.bijective_of_nat_card_le ?_
  rw [IsGalois.card_aut_eq_finrank, IsGalois.card_aut_eq_finrank, std_finrank_U hM hU hdeg]

theorem stdResU_bijective : Function.Bijective (stdResU (K := K) (M := M) (F := F) hU) := by
  haveI := isGalois_of_isUnramified hU
  haveI := finiteDimensional_tower (p := p) K U
  haveI := finiteDimensional_tower (p := p) K F
  haveI := finiteDimensional_tower (p := p) M F
  haveI : IsGalois M F := IsGalois.tower_top_of_isGalois K M F
  have hinj : Function.Injective (stdResU (K := K) (M := M) (F := F) hU) := by
    rw [injective_iff_map_eq_one]
    intro g hg
    have hE := std_eq_top hM hU hdeg
      (IntermediateField.fixedField (Subgroup.zpowers (g.restrictScalars K)))
      (fun m ↦ by
        rintro ⟨_, k, rfl⟩
        have : g.restrictScalars K (algebraMap M F m) = algebraMap M F m := g.commutes m
        change (g.restrictScalars K ^ k) (algebraMap M F m) = _
        exact zpow_apply_eq_of_apply_eq this k)
      (fun u ↦ by
        rintro ⟨_, k, rfl⟩
        change (g.restrictScalars K ^ k) (algebraMap U F u) = _
        have : g.restrictScalars K (algebraMap U F u) = algebraMap U F u := by
          have h := stdResU_apply hU g u
          rw [hg, AlgEquiv.one_apply] at h
          exact h.symm
        exact zpow_apply_eq_of_apply_eq this k)
    ext x
    have hx : x ∈ IntermediateField.fixedField (Subgroup.zpowers (g.restrictScalars K)) :=
      hE ▸ IntermediateField.mem_top
    exact hx ⟨g.restrictScalars K, Subgroup.mem_zpowers _⟩
  refine hinj.bijective_of_nat_card_le ?_
  rw [IsGalois.card_aut_eq_finrank, IsGalois.card_aut_eq_finrank, std_finrank_M hM hU hdeg]

/-- `N_{F/M}(a) = N_{U/K}(a)` for `a ∈ U`. -/
theorem std_norm_U (a : U) :
    Algebra.norm M (algebraMap U F a) = algebraMap K M (Algebra.norm K a) := by
  haveI := isGalois_of_isUnramified hU
  haveI := finiteDimensional_tower (p := p) K U
  haveI := finiteDimensional_tower (p := p) M F
  haveI : IsGalois M F := IsGalois.tower_top_of_isGalois K M F
  apply (algebraMap M F).injective
  rw [Algebra.norm_eq_prod_automorphisms, ← IsScalarTower.algebraMap_apply,
    IsScalarTower.algebraMap_apply K U F, Algebra.norm_eq_prod_automorphisms, map_prod]
  exact (Fintype.prod_bijective _ (stdResU_bijective hM hU hdeg) _ _
    fun g ↦ (stdResU_apply hU g a).symm)

/-- `N_{F/U}(m) = N_{M/K}(m)` for `m ∈ M`. -/
theorem std_norm_M (m : M) :
    Algebra.norm U (algebraMap M F m) = algebraMap K U (Algebra.norm K m) := by
  haveI := finiteDimensional_tower (p := p) K M
  haveI := finiteDimensional_tower (p := p) U F
  haveI : IsGalois U F := IsGalois.tower_top_of_isGalois K U F
  apply (algebraMap U F).injective
  rw [Algebra.norm_eq_prod_automorphisms, ← IsScalarTower.algebraMap_apply,
    IsScalarTower.algebraMap_apply K M F, Algebra.norm_eq_prod_automorphisms, map_prod]
  exact (Fintype.prod_bijective _ (stdResM_bijective hM hU hdeg) _ _
    fun g ↦ (stdResM_apply (K := K) g m).symm)

end Galois

end Std

end PadicField
